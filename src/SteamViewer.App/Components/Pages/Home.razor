@page "/"
@using SteamViewer.Client.Core.Capture
@using SteamViewer.Client.Core.FileTransfer
@using SteamViewer.Client.Core.Network
@using SteamViewer.Client.Core.Session
@using SteamViewer.App.Services
@using SteamViewer.App.Components.FileTransfer
@using Blake3
@using System.Text
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.Extensions.Configuration
@implements IAsyncDisposable
@inject SignalingClient SignalingClient
@inject SessionManager SessionManager
@inject CanvasRenderingService CanvasRenderer
@inject IJSRuntime JSRuntime
@inject ILoggerFactory LoggerFactory
@inject ILogger<Home> Logger
@inject IInputInjector InputInjector
@inject IConfiguration Configuration
@inject FileLoggerService FileLogger
@inject RemoteViewerService ViewerService

<div class="version-tag">v@(Version)</div>
<div class="container">
    @if (currentMode == AppMode.Select)
    {
        <div class="mode-select">
            <img src="images/logo.png" alt="SteamViewer" class="app-logo" />
            <p class="subtitle">Secure Remote Desktop</p>

            <div class="mode-buttons">
                <button class="mode-btn host-btn" @onclick="SelectStartMode">
                    <span class="icon">1:1</span>
                    <span class="label">Start Session</span>
                    <span class="desc">Share your screen with others</span>
                </button>

                <button class="mode-btn viewer-btn" @onclick="SelectJoinMode">
                    <span class="icon">-></span>
                    <span class="label">Join Session</span>
                    <span class="desc">Connect to an existing session</span>
                </button>
            </div>

            <a href="/collaboration" class="collaboration-link">
                <span class="collab-icon">N:N</span>
                <span>Collaboration Mode</span>
                <span class="collab-desc">Multi-user screen sharing</span>
            </a>
        </div>
    }
    else if (currentMode == AppMode.StartConnection)
    {
        <div class="session-view">
            <h2>Start Session</h2>

            @if (connectionState == ConnectionState.Idle || connectionState == ConnectionState.Registering)
            {
                <p>Setting up session...</p>
                <div class="spinner"></div>
                <button class="secondary-btn" @onclick="GoBack">Cancel</button>
            }
            else if (connectionState == ConnectionState.Registered)
            {
                <div class="credentials">
                    <div class="credential-item">
                        <label>Session ID</label>
                        <div class="value">@clientId</div>
                    </div>
                    <div class="credential-item">
                        <label>Password</label>
                        <div class="value">@password</div>
                    </div>
                </div>
                <p class="status">Share these credentials with your partner</p>
                <button class="secondary-btn" @onclick="StopSession">Cancel</button>
            }
            else if (connectionState == ConnectionState.Connecting)
            {
                <p>Incoming connection request</p>
                <div class="connection-prompt">
                    <button class="primary-btn" @onclick="AcceptConnection">Accept</button>
                    <button class="secondary-btn" @onclick="RejectConnection">Reject</button>
                </div>
            }
            else if (connectionState == ConnectionState.Connected)
            {
                @* Render connected view *@
                @RenderConnectedView()
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error">@errorMessage</div>
            }
        </div>
    }
    else if (currentMode == AppMode.JoinConnection)
    {
        <div class="session-view">
            <h2>Join Session</h2>

            @if (connectionState == ConnectionState.Idle || connectionState == ConnectionState.Registered)
            {
                <div class="connect-form">
                    <div class="input-group">
                        <label>Session ID</label>
                        <input type="text" @bind="targetId" placeholder="@_idPlaceholder" maxlength="@_idMaxLength" />
                    </div>
                    <div class="input-group">
                        <label>Password</label>
                        <input type="password" @bind="targetPassword" placeholder="Enter password" />
                    </div>
                    <div class="form-buttons">
                        <button class="secondary-btn" @onclick="GoBack">Back</button>
                        <button class="primary-btn" @onclick="JoinSession" disabled="@(string.IsNullOrWhiteSpace(targetId) || string.IsNullOrWhiteSpace(targetPassword))">
                            Join
                        </button>
                    </div>
                </div>
            }
            else if (connectionState == ConnectionState.Connecting)
            {
                <p>Connecting...</p>
                <div class="spinner"></div>
                <button class="secondary-btn" @onclick="GoBack">Cancel</button>
            }
            else if (connectionState == ConnectionState.Connected)
            {
                @* Render connected view *@
                @RenderConnectedView()
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error">@errorMessage</div>
            }
        </div>
    }

    <FileTransferDialog
        IsVisible="@_showFileTransferDialog"
        Mode="@_fileDialogMode"
        PendingTransfer="@_pendingFileTransfer"
        Transfers="@SessionManager.ActiveTransfers"
        OnClose="@CloseFileTransferDialog"
        OnAccept="@AcceptFileTransfer"
        OnReject="@RejectFileTransfer"
        OnCancel="@CancelFileTransfer" />
</div>


@code {
    private static readonly string Version = System.Reflection.CustomAttributeExtensions
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(Home).Assembly)?.InformationalVersion?.Split('+')[0] ?? "0.0.0";

    private enum AppMode { Select, StartConnection, JoinConnection }

    private AppMode currentMode = AppMode.Select;
    private ConnectionState connectionState = ConnectionState.Idle;

    // Session state
    private string clientId = "";
    private string password = "";
    private string incomingPeerId = "";
    private string connectedPeerId = "";

    // Join mode state
#if DEBUG
    private string targetId = "";  // User types short machine name
    private string targetPassword = "TESTPASS";
    private string _idPlaceholder = "Enter machine name";
    private string _idMaxLength = "50";
#else
    private string targetId = "";
    private string targetPassword = "";
    private string _idPlaceholder = "Enter 9-digit ID";
    private string _idMaxLength = "9";
#endif

    private string errorMessage = "";
    private bool _canvasInitialized;
    private bool _isRendering;
    private bool _inputCaptureInitialized;
    private DotNetObjectReference<Home>? _inputDotNetRef;
    private DotNetObjectReference<Home>? _loggerDotNetRef;
    private bool _jsLoggerInitialized;

    // WebRTC state
    private WebRTCManager? _webrtc;
    private bool _webrtcInitialized;
    private string _sessionId = "host"; // Session ID for JS interop (host uses constant "host")

    // Screen sharing state
    private bool _isSharingScreen;       // Am I sharing my screen?
    private bool _peerIsSharingScreen;   // Is my peer sharing their screen?
    private bool _dataChannelReady;      // Is data channel open and ready?

    // Track last known capture dimensions from mouse events (for keyboard events)
    private int _lastCaptureWidth = 1920;
    private int _lastCaptureHeight = 1080;

    // Pending SDP offer/ICE candidates (buffered if received before WebRTC init)
    private SignalingMessage.SdpOffer? _pendingSdpOffer;
    private List<SignalingMessage.IceCandidate> _pendingIceCandidates = new();

    // File transfer state
    private bool _showFileTransferDialog;
    private FileTransferDialog.DialogMode _fileDialogMode;
    private FileTransferState? _pendingFileTransfer;

    // Render the connected view (same for both Start and Join modes)
    private RenderFragment RenderConnectedView() => __builder =>
    {
        <div class="connected-view">
            <p class="status connected">Connected to peer</p>

            @* Screen sharing controls *@
            <div class="screen-share-controls">
                @if (_isSharingScreen)
                {
                    <button class="share-btn sharing" @onclick="StopSharingScreen">
                        <span class="icon">🛑</span>
                        <span>Stop Sharing</span>
                    </button>
                    <p class="share-status">You are sharing your screen</p>
                }
                else
                {
                    <button class="share-btn" @onclick="StartSharingScreen" disabled="@(!_dataChannelReady)">
                        <span class="icon">🖥️</span>
                        <span>Share My Screen</span>
                    </button>
                    @if (!_dataChannelReady)
                    {
                        <p class="connecting-status">Establishing connection...</p>
                    }
                }
            </div>

            @* Remote screen display (when peer is sharing) *@
            @if (_peerIsSharingScreen)
            {
                @* Hide visually when viewer window is open, but keep canvas for frame capture *@
                <div class="remote-screen-container @(ViewerService.IsViewerOpen ? "hidden-for-capture" : "")">
                    <div class="remote-screen-header">
                        <span class="remote-label">📺 Remote Screen</span>
                        <button class="popout-btn" @onclick="async () => await OpenViewerWindow()" title="Open in separate window">
                            <span>⛶</span> Open Window
                        </button>
                    </div>
                    <div class="remote-screen">
                        <canvas id="remoteCanvas" width="1920" height="1080"></canvas>
                    </div>
                </div>
                @if (ViewerService.IsViewerOpen)
                {
                    <p class="viewer-open-status">Viewing in separate window</p>
                }
            }
            else if (!_isSharingScreen)
            {
                <p class="waiting-status">Waiting for screen share...</p>
            }

            @* Toolbar *@
            <div class="session-toolbar">
                <button class="toolbar-btn" @onclick="ShowTransfersDialog">📁 Transfers</button>
                <button class="toolbar-btn disconnect" @onclick="Disconnect">⏏ Disconnect</button>
            </div>
        </div>
    };

    protected override void OnInitialized()
    {
        SignalingClient.OnMessageReceived += HandleMessage;
        SignalingClient.OnDisconnected += HandleDisconnected;
        SignalingClient.OnError += HandleError;
        SessionManager.VideoFrameDecoded += OnVideoFrameDecoded;
        SessionManager.IncomingFileTransfer += OnIncomingFileTransfer;
        SessionManager.FileTransferProgress += OnFileTransferProgress;
        SessionManager.FileTransferCompleted += OnFileTransferCompleted;
        SessionManager.FileTransferFailed += OnFileTransferFailed;

        // Subscribe to viewer window events
        ViewerService.OnInputEvent += OnViewerInputEvent;
        ViewerService.OnViewerClosed += OnViewerClosed;
        ViewerService.OnStatsToggleRequested += OnViewerStatsToggle;
    }

    private async void OnViewerClosed()
    {
        // Stop stats relay when viewer closes
        if (_statsRelayEnabled)
        {
            OnViewerStatsToggle(false);
        }
        await StopFrameCaptureAsync();
    }

    private bool _statsRelayEnabled;

    private async void OnViewerStatsToggle(bool enable)
    {
        _statsRelayEnabled = enable;
        try
        {
            if (enable)
                await JSRuntime.InvokeVoidAsync("SteamViewerWebRTC.enableStatsRelay", _sessionId);
            else
                await JSRuntime.InvokeVoidAsync("SteamViewerWebRTC.disableStatsRelay", _sessionId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to toggle stats relay");
        }
    }

    private void OnWebRTCStatsUpdate(string json)
    {
        if (_statsRelayEnabled && ViewerService.IsViewerOpen)
        {
            ViewerService.SendStatsUpdate(json);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Initialize JS logger on first render
        if (firstRender && !_jsLoggerInitialized)
        {
            try
            {
                _loggerDotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("SteamViewerLogger.initialize", _loggerDotNetRef);
                _jsLoggerInitialized = true;
                Logger.LogInformation("JS Logger initialized - log file: {Path}", FileLogger.LogFilePath);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to initialize JS logger");
            }
        }

        // Initialize canvas and input capture when peer is sharing screen
        if (_peerIsSharingScreen &&
            connectionState == ConnectionState.Connected &&
            !_canvasInitialized)
        {
            try
            {
                await CanvasRenderer.InitializeAsync("remoteCanvas");
                _canvasInitialized = true;
                Logger.LogInformation("Canvas initialized for video rendering");

                // Initialize input capture on canvas (no lock indicator - viewer window handles that)
                if (!_inputCaptureInitialized)
                {
                    _inputDotNetRef = DotNetObjectReference.Create(this);
                    var success = await JSRuntime.InvokeAsync<bool>(
                        "SteamViewerInput.initialize",
                        "remoteCanvas",
                        _inputDotNetRef,
                        new { showLockIndicator = false });
                    _inputCaptureInitialized = success;
                    if (success)
                    {
                        await JSRuntime.InvokeVoidAsync("SteamViewerInput.setActiveSession", _sessionId);
                    }
                    Logger.LogInformation("Input capture initialized: {Success}", success);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to initialize canvas/input");
            }
        }
    }

    private void OnVideoFrameDecoded(object? sender, DecodedFrame frame)
    {
        // Forward frame to viewer window if open
        if (ViewerService.IsViewerOpen)
        {
            ViewerService.SendVideoFrame(frame);
        }

        // Also render in main window if canvas is ready
        if (!_canvasInitialized || _isRendering)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                _isRendering = true;
                await CanvasRenderer.RenderFrameAsync(frame);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to render video frame");
            }
            finally
            {
                _isRendering = false;
            }
        });
    }

    #region File Transfer Handlers

    private void OnIncomingFileTransfer(object? sender, FileTransferState state)
    {
        InvokeAsync(() =>
        {
            _pendingFileTransfer = state;
            _fileDialogMode = FileTransferDialog.DialogMode.IncomingRequest;
            _showFileTransferDialog = true;
            StateHasChanged();
        });
    }

    private void OnFileTransferProgress(object? sender, FileTransferState state)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnFileTransferCompleted(object? sender, FileTransferState state)
    {
        InvokeAsync(() =>
        {
            Logger.LogInformation("File transfer completed: {Filename}", state.Filename);
            StateHasChanged();
        });
    }

    private void OnFileTransferFailed(object? sender, FileTransferState state)
    {
        InvokeAsync(() =>
        {
            Logger.LogWarning("File transfer failed: {Filename} - {Error}", state.Filename, state.ErrorMessage);
            StateHasChanged();
        });
    }

    private void ShowTransfersDialog()
    {
        _fileDialogMode = FileTransferDialog.DialogMode.ActiveTransfers;
        _showFileTransferDialog = true;
        StateHasChanged();
    }

    private void CloseFileTransferDialog()
    {
        _showFileTransferDialog = false;
        _pendingFileTransfer = null;
        StateHasChanged();
    }

    private async Task AcceptFileTransfer((Guid TransferId, string SavePath) args)
    {
        try
        {
            await SessionManager.AcceptFileTransferAsync(args.TransferId, args.SavePath);
            _showFileTransferDialog = false;
            _pendingFileTransfer = null;
            // Show active transfers dialog
            _fileDialogMode = FileTransferDialog.DialogMode.ActiveTransfers;
            _showFileTransferDialog = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to accept file transfer");
            errorMessage = ex.Message;
        }
        StateHasChanged();
    }

    private async Task RejectFileTransfer(Guid transferId)
    {
        try
        {
            await SessionManager.RejectFileTransferAsync(transferId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reject file transfer");
        }
        _showFileTransferDialog = false;
        _pendingFileTransfer = null;
        StateHasChanged();
    }

    private async Task CancelFileTransfer(Guid transferId)
    {
        try
        {
            await SessionManager.CancelFileTransferAsync(transferId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to cancel file transfer");
        }
        StateHasChanged();
    }

    #endregion

    private async Task SelectStartMode()
    {
        currentMode = AppMode.StartConnection;
        StateHasChanged();
        // Auto-start session immediately
        await StartSession();
    }

    private void SelectJoinMode()
    {
        currentMode = AppMode.JoinConnection;
        StateHasChanged();
    }

    private async Task GoBack()
    {
        await StopSession();
        _canvasInitialized = false;
        _isSharingScreen = false;
        _peerIsSharingScreen = false;
        currentMode = AppMode.Select;
        connectionState = ConnectionState.Idle;
        errorMessage = "";
        StateHasChanged();
    }


    #region Screen Sharing

    private async Task StartSharingScreen()
    {
        if (_webrtc == null) return;

        try
        {
            Logger.LogInformation("Starting screen share...");
            var success = await _webrtc.StartScreenCaptureAsync();
            if (success)
            {
                _isSharingScreen = true;
                Logger.LogInformation("Screen sharing started, notifying peer...");

                // Wait a moment for track to be added, then notify peer
                await Task.Delay(500);

                // Send notification multiple times to ensure delivery
                for (int i = 0; i < 3; i++)
                {
                    var sent = await _webrtc.SendDataAsync(JsonSerializer.Serialize(new { type = "screenShareStarted" }));
                    Logger.LogInformation("screenShareStarted message sent: {Sent}", sent);
                    if (sent) break;
                    await Task.Delay(200);
                }
            }
            else
            {
                errorMessage = "Failed to start screen capture";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start screen sharing");
            errorMessage = ex.Message;
        }
        StateHasChanged();
    }

    private async Task StopSharingScreen()
    {
        if (_webrtc == null) return;

        try
        {
            Logger.LogInformation("Stopping screen share...");
            await _webrtc.StopScreenCaptureAsync();
            _isSharingScreen = false;
            // Notify peer that we stopped sharing
            await _webrtc.SendDataAsync(JsonSerializer.Serialize(new { type = "screenShareStopped" }));
            Logger.LogInformation("Screen sharing stopped");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to stop screen sharing");
        }
        StateHasChanged();
    }

    #endregion

    #region Separate Window Viewer

    private DotNetObjectReference<Home>? _frameCaptureRef;

    private async Task OpenViewerWindow()
    {
        // Open the viewer in a separate window
        ViewerService.OpenViewer(connectedPeerId);
        Logger.LogInformation("Opened viewer window for peer {PeerId}", connectedPeerId);

        // Update UI to hide main window canvas
        StateHasChanged();

        // Start frame capture to relay video to viewer window
        await Task.Delay(500); // Wait for viewer window to initialize
        await StartFrameCaptureAsync();
    }

    private async Task StartFrameCaptureAsync()
    {
        try
        {
            _frameCaptureRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("SteamViewerWebRTC.startFrameCapture", _sessionId, _frameCaptureRef);
            Logger.LogInformation("Frame capture started for viewer window");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to start frame capture");
        }
    }

    private async Task StopFrameCaptureAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("SteamViewerWebRTC.stopFrameCapture", _sessionId);
            _frameCaptureRef?.Dispose();
            _frameCaptureRef = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to stop frame capture");
        }
    }

    [JSInvokable]
    public void OnFrameCaptured(string base64Data, int width, int height)
    {
        if (!ViewerService.IsViewerOpen) return;

        try
        {
            ViewerService.SendJpegFrame(base64Data, width, height);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to relay frame to viewer");
        }
    }

    private void OnViewerInputEvent(InputEventData input)
    {
        // Relay input from viewer window to remote peer
        _ = InvokeAsync(async () =>
        {
            try
            {
                switch (input.Type)
                {
                    case InputEventType.MouseMove:
                        await OnMouseMove(input.X, input.Y, input.CaptureWidth, input.CaptureHeight);
                        break;
                    case InputEventType.MouseDown:
                        await OnMouseDown(input.Button.ToString(), input.X, input.Y, input.CaptureWidth, input.CaptureHeight);
                        break;
                    case InputEventType.MouseUp:
                        await OnMouseUp(input.Button.ToString(), input.X, input.Y, input.CaptureWidth, input.CaptureHeight);
                        break;
                    case InputEventType.Wheel:
                        await OnMouseWheel(input.DeltaX, input.DeltaY);
                        break;
                    case InputEventType.KeyDown:
                        var downMods = JsonSerializer.SerializeToElement(new { ctrl = input.Ctrl, shift = input.Shift, alt = input.Alt });
                        await OnKeyDown(input.Key!, downMods);
                        break;
                    case InputEventType.KeyUp:
                        var upMods = JsonSerializer.SerializeToElement(new { ctrl = input.Ctrl, shift = input.Shift, alt = input.Alt });
                        await OnKeyUp(input.Key!, upMods);
                        break;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to relay input from viewer window");
            }
        });
    }

    #endregion

    private async Task StartSession()
    {
        try
        {
            connectionState = ConnectionState.Registering;
            errorMessage = "";
            StateHasChanged();

            await SignalingClient.ConnectAsync();

#if DEBUG
            // Use machine name as ID for unique, memorable debug credentials
            clientId = Environment.MachineName;
            password = "TESTPASS";
            Logger.LogInformation("DEBUG MODE: Using test credentials - ID: {Id}, Password: {Pass}", clientId, password);
#else
            // Generate 9-digit client ID
            clientId = new Random().Next(100000000, 999999999).ToString();

            // Generate random password
            password = Guid.NewGuid().ToString("N")[..8].ToUpperInvariant();
#endif

            // Hash password for registration
            var passwordHash = Convert.ToHexString(
                Hasher.Hash(Encoding.UTF8.GetBytes(password)).AsSpan()
            ).ToLowerInvariant();

            var success = await SignalingClient.RegisterAsync(clientId, passwordHash);

            if (success)
            {
                connectionState = ConnectionState.Registered;
            }
            else
            {
                connectionState = ConnectionState.Error;
                errorMessage = "Failed to register with server";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start hosting");
            connectionState = ConnectionState.Error;
            errorMessage = ex.Message;
        }

        StateHasChanged();
    }

    private async Task StopSession()
    {
        try
        {
            await SignalingClient.DisconnectAsync();
            if (_webrtc != null)
            {
                await _webrtc.CloseAsync();
                _webrtc = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error during disconnect");
        }

        connectionState = ConnectionState.Idle;
        clientId = "";
        password = "";
        _isSharingScreen = false;
        _peerIsSharingScreen = false;
        StateHasChanged();
    }

    private async Task JoinSession()
    {
        try
        {
            connectionState = ConnectionState.Connecting;
            errorMessage = "";
            StateHasChanged();

            if (!SignalingClient.IsConnected)
            {
                await SignalingClient.ConnectAsync();

                // Register with a random ID (joining peer)
                var joinerId = new Random().Next(100000000, 999999999).ToString();
                var joinerPasswordHash = Convert.ToHexString(
                    Hasher.Hash(Encoding.UTF8.GetBytes(Guid.NewGuid().ToString())).AsSpan()
                ).ToLowerInvariant();

                await SignalingClient.RegisterAsync(joinerId, joinerPasswordHash);
            }

            await SignalingClient.RequestConnectionAsync(targetId, targetPassword);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to join session");
            connectionState = ConnectionState.Error;
            errorMessage = ex.Message;
            StateHasChanged();
        }
    }

    private async Task AcceptConnection()
    {
        try
        {
            await SignalingClient.RespondToConnectionAsync(incomingPeerId, true);
            connectedPeerId = incomingPeerId;
            connectionState = ConnectionState.Connected;

            // Initialize WebRTC as host
            await InitializeWebRTCAsHost();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to accept connection");
            errorMessage = ex.Message;
        }
        StateHasChanged();
    }

    private async Task SetTurnConfigFromSettings()
    {
        // Read TURN server config from appsettings.json
        var turnEnabled = Configuration.GetValue<bool>("TurnServer:Enabled");
        if (!turnEnabled)
        {
            Logger.LogInformation("TURN server disabled in config");
            return;
        }

        var urls = Configuration.GetSection("TurnServer:Urls").Get<string[]>();
        var username = Configuration["TurnServer:Username"];
        var credential = Configuration["TurnServer:Credential"];

        if (urls == null || urls.Length == 0 || string.IsNullOrEmpty(username))
        {
            Logger.LogWarning("TURN server enabled but not configured - edit appsettings.json");
            return;
        }

        // Check if URL is placeholder
        if (urls[0].Contains("YOUR_TURN_SERVER"))
        {
            Logger.LogWarning("TURN server URL is placeholder - edit appsettings.json with your TURN server address");
            return;
        }

        Logger.LogInformation("Configuring TURN server: {Urls}", string.Join(", ", urls));
        await JSRuntime.InvokeVoidAsync("SteamViewerWebRTC.setTurnConfig", urls, username, credential);
    }

    private async Task InitializeWebRTCAsHost()
    {
        Logger.LogInformation("Initializing WebRTC as host");

        // Configure TURN server before WebRTC init
        await SetTurnConfigFromSettings();

        // Set logger to host mode (receives logs from viewer)
        await JSRuntime.InvokeVoidAsync("SteamViewerLogger.setMode", true);

        _webrtc = new WebRTCManager(JSRuntime, LoggerFactory.CreateLogger<WebRTCManager>(), _sessionId, clientId, SendSignalingMessage);

        // Subscribe to ICE candidates
        _webrtc.OnIceCandidate += async (candidateJson) =>
        {
            var candidate = JsonSerializer.Deserialize<IceCandidateData>(candidateJson);
            if (candidate != null)
            {
                await SignalingClient.SendIceCandidateAsync(connectedPeerId, candidate.candidate, candidate.sdpMid, (ushort?)candidate.sdpMLineIndex);
            }
        };

        // Subscribe to data channel messages (for receiving input and screen share notifications)
        _webrtc.OnDataChannelMessage += async (json) =>
        {
            await HandleDataChannelMessageAsync(json);
        };

        // Subscribe to renegotiation (triggered when screen capture track is added)
        _webrtc.OnRenegotiationNeeded += async (offerJson) =>
        {
            Logger.LogInformation("Renegotiation: sending new offer to {PeerId}", connectedPeerId);
            await SignalingClient.SendSdpOfferAsync(connectedPeerId, offerJson);
        };

        // Subscribe to data channel open (host needs this too!)
        _webrtc.OnDataChannelOpen += async () =>
        {
            Logger.LogInformation("Host: Data channel opened - ready for communication");
            _dataChannelReady = true;
            await InvokeAsync(StateHasChanged);
        };

        // Subscribe to stats relay (for cross-window overlay)
        _webrtc.OnStatsUpdated += OnWebRTCStatsUpdate;

        await _webrtc.InitializeAsync();
        _webrtcInitialized = true;
        await _webrtc.CreateDataChannelAsync("data");

        // NOTE: Screen capture is NOT auto-started; user chooses when to share

        // Create and send offer
        var offer = await _webrtc.CreateOfferAsync();
        await SignalingClient.SendSdpOfferAsync(connectedPeerId, offer);
        Logger.LogInformation("SDP offer sent to {PeerId}", connectedPeerId);
    }

    private async Task SendSignalingMessage(SignalingMessage message)
    {
        await SignalingClient.SendAsync(message);
    }

    private record IceCandidateData(string candidate, string? sdpMid, int? sdpMLineIndex);

    #region JS Logger

    [JSInvokable]
    public void OnJSLog(string level, string message)
    {
        FileLogger.LogJS(level, message);
    }

    #endregion

    #region Input Event Handlers (Viewer -> Host)

    [JSInvokable]
    public async Task OnMouseMove(double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        if (_webrtc == null || !_webrtc.IsDataChannelOpen) return;
        var inputEvent = new InputEvent.MouseMove(x, y, captureWidth, captureHeight);
        await SendInputEventAsync(inputEvent);
    }

    [JSInvokable]
    public async Task OnMouseDown(string button, double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        if (_webrtc == null || !_webrtc.IsDataChannelOpen) return;
        var mouseButton = button.ToLowerInvariant() switch
        {
            "left" => MouseButton.Left,
            "right" => MouseButton.Right,
            "middle" => MouseButton.Middle,
            _ => MouseButton.Left
        };
        var inputEvent = new InputEvent.MouseDown(mouseButton, x, y, captureWidth, captureHeight);
        await SendInputEventAsync(inputEvent);
    }

    [JSInvokable]
    public async Task OnMouseUp(string button, double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        if (_webrtc == null || !_webrtc.IsDataChannelOpen) return;
        var mouseButton = button.ToLowerInvariant() switch
        {
            "left" => MouseButton.Left,
            "right" => MouseButton.Right,
            "middle" => MouseButton.Middle,
            _ => MouseButton.Left
        };
        var inputEvent = new InputEvent.MouseUp(mouseButton, x, y, captureWidth, captureHeight);
        await SendInputEventAsync(inputEvent);
    }

    [JSInvokable]
    public async Task OnMouseWheel(double deltaX, double deltaY)
    {
        if (_webrtc == null || !_webrtc.IsDataChannelOpen) return;
        var inputEvent = new InputEvent.MouseWheel(deltaX, deltaY);
        await SendInputEventAsync(inputEvent);
    }

    [JSInvokable]
    public async Task OnKeyDown(string key, JsonElement modifiers)
    {
        if (_webrtc == null || !_webrtc.IsDataChannelOpen) return;
        var mods = ParseModifiers(modifiers);
        var inputEvent = new InputEvent.KeyDown(key, mods);
        await SendInputEventAsync(inputEvent);
    }

    [JSInvokable]
    public async Task OnKeyUp(string key, JsonElement modifiers)
    {
        if (_webrtc == null || !_webrtc.IsDataChannelOpen) return;
        var mods = ParseModifiers(modifiers);
        var inputEvent = new InputEvent.KeyUp(key, mods);
        await SendInputEventAsync(inputEvent);
    }

    private KeyModifiers ParseModifiers(JsonElement modifiers)
    {
        bool ctrl = false, shift = false, alt = false, meta = false;
        if (modifiers.TryGetProperty("ctrl", out var ctrlProp)) ctrl = ctrlProp.GetBoolean();
        if (modifiers.TryGetProperty("shift", out var shiftProp)) shift = shiftProp.GetBoolean();
        if (modifiers.TryGetProperty("alt", out var altProp)) alt = altProp.GetBoolean();
        if (modifiers.TryGetProperty("meta", out var metaProp)) meta = metaProp.GetBoolean();
        return new KeyModifiers(ctrl, shift, alt, meta);
    }

    private async Task SendInputEventAsync(InputEvent inputEvent)
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(inputEvent);
            await _webrtc!.SendDataAsync(json);
        }
        catch
        {
            // Silently ignore input send failures to reduce latency
        }
    }

    #endregion

    #region Input Injection (Host receives from Viewer)

    private async Task HandleInputMessageAsync(string json)
    {
        // Only process input if we're sharing our screen (i.e., receiving remote control)
        if (!_isSharingScreen) return;

        try
        {
            var inputEvent = JsonSerializer.Deserialize<InputEvent>(json);
            if (inputEvent != null)
            {
                // Track dimensions from mouse events (they carry the viewer's canvas size)
                // Keyboard events will reuse the last known dimensions
                switch (inputEvent)
                {
                    case InputEvent.MouseMove move when move.CaptureWidth > 0 && move.CaptureHeight > 0:
                        _lastCaptureWidth = move.CaptureWidth;
                        _lastCaptureHeight = move.CaptureHeight;
                        break;
                    case InputEvent.MouseDown down when down.CaptureWidth > 0 && down.CaptureHeight > 0:
                        _lastCaptureWidth = down.CaptureWidth;
                        _lastCaptureHeight = down.CaptureHeight;
                        break;
                    case InputEvent.MouseUp up when up.CaptureWidth > 0 && up.CaptureHeight > 0:
                        _lastCaptureWidth = up.CaptureWidth;
                        _lastCaptureHeight = up.CaptureHeight;
                        break;
                }

                // Inject the input using tracked capture dimensions
                InputInjector.InjectInput(inputEvent, _lastCaptureWidth, _lastCaptureHeight);
            }
        }
        catch
        {
            // Silently ignore parse errors to reduce latency
        }

        await Task.CompletedTask;
    }

    #endregion

    #region Data Channel Message Handler

    private async Task HandleDataChannelMessageAsync(string json)
    {
        try
        {
            // Try to parse as a control message first
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("type", out var typeElement))
            {
                var type = typeElement.GetString();
                switch (type)
                {
                    case "screenShareStarted":
                        Logger.LogInformation("Peer started sharing their screen");
                        await InvokeAsync(async () =>
                        {
                            _peerIsSharingScreen = true;
                            StateHasChanged();

                            // Give time for track to be received and renegotiation to complete
                            await Task.Delay(500);

                            // Manually check for video tracks (in case ontrack didn't fire)
                            await JSRuntime.InvokeVoidAsync("SteamViewerWebRTC.checkForVideoTracks", _sessionId);

                            // Auto-open viewer window
                            await OpenViewerWindow();
                        });
                        return;

                    case "screenShareStopped":
                        Logger.LogInformation("Peer stopped sharing their screen");
                        await InvokeAsync(async () =>
                        {
                            _peerIsSharingScreen = false;
                            _canvasInitialized = false; // Reset canvas for next share
                            await StopFrameCaptureAsync();
                            ViewerService.CloseViewer(); // Close viewer window if open
                            StateHasChanged();
                        });
                        return;
                }
            }

            // If not a control message, treat as input event
            await HandleInputMessageAsync(json);
        }
        catch (JsonException)
        {
            // Not JSON, might be raw data - try as input
            await HandleInputMessageAsync(json);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to handle data channel message: {Json}", json);
        }
    }

    #endregion

    private async Task RejectConnection()
    {
        await SignalingClient.RespondToConnectionAsync(incomingPeerId, false);
        connectionState = ConnectionState.Registered;
        incomingPeerId = "";
        StateHasChanged();
    }

    private async Task Disconnect()
    {
        if (!string.IsNullOrEmpty(connectedPeerId))
        {
            await SignalingClient.DisconnectFromPeerAsync(connectedPeerId);
        }

        connectedPeerId = "";
        _canvasInitialized = false;
        _dataChannelReady = false;
        _webrtcInitialized = false;
        _isSharingScreen = false;
        _peerIsSharingScreen = false;
        _pendingSdpOffer = null;
        _pendingIceCandidates.Clear();

        if (currentMode == AppMode.StartConnection)
        {
            connectionState = ConnectionState.Registered;
        }
        else
        {
            connectionState = ConnectionState.Idle;
        }

        StateHasChanged();
    }

    private void HandleMessage(SignalingMessage message)
    {
        InvokeAsync(async () =>
        {
            switch (message)
            {
                case SignalingMessage.IncomingConnection incoming:
                    incomingPeerId = incoming.FromId;
                    connectionState = ConnectionState.Connecting;
                    break;

                case SignalingMessage.ConnectionResponse response:
                    if (response.TargetId != targetId && response.TargetId != incomingPeerId) break;
                    if (response.Approved)
                    {
                        connectedPeerId = response.TargetId;
                        connectionState = ConnectionState.Connected;

                        // Initialize WebRTC as viewer
                        await InitializeWebRTCAsViewer();
                    }
                    else
                    {
                        errorMessage = "Connection rejected";
                        connectionState = currentMode == AppMode.StartConnection ? ConnectionState.Registered : ConnectionState.Idle;
                    }
                    break;

                case SignalingMessage.SdpOffer offer:
                    if (offer.TargetId != connectedPeerId) break;
                    Logger.LogInformation("Received SDP offer from {PeerId}", offer.TargetId);
                    if (_webrtc != null && _webrtcInitialized)
                    {
                        await _webrtc.SetRemoteDescriptionAsync(offer.Sdp);
                        var answer = await _webrtc.CreateAnswerAsync();
                        await SignalingClient.SendSdpAnswerAsync(offer.TargetId, answer);
                        Logger.LogInformation("SDP answer sent");
                    }
                    else
                    {
                        // Buffer offer - WebRTC not yet initialized (race condition)
                        Logger.LogWarning("WebRTC not ready, buffering SDP offer");
                        _pendingSdpOffer = offer;
                    }
                    break;

                case SignalingMessage.SdpAnswer answer:
                    if (answer.TargetId != connectedPeerId) break;
                    Logger.LogInformation("Received SDP answer from {PeerId}", answer.TargetId);
                    if (_webrtc != null)
                    {
                        await _webrtc.SetRemoteDescriptionAsync(answer.Sdp);
                    }
                    break;

                case SignalingMessage.IceCandidate ice:
                    if (ice.TargetId != connectedPeerId) break;
                    Logger.LogDebug("Received ICE candidate from {PeerId}", ice.TargetId);
                    if (_webrtc != null && _webrtcInitialized)
                    {
                        var candidateJson = System.Text.Json.JsonSerializer.Serialize(new
                        {
                            candidate = ice.Candidate,
                            sdpMid = ice.SdpMid,
                            sdpMLineIndex = ice.SdpMLineIndex
                        });
                        await _webrtc.AddIceCandidateAsync(candidateJson);
                    }
                    else
                    {
                        // Buffer ICE candidate - WebRTC not yet initialized
                        Logger.LogDebug("WebRTC not ready, buffering ICE candidate");
                        _pendingIceCandidates.Add(ice);
                    }
                    break;

                case SignalingMessage.Disconnected disconnected:
                    if (disconnected.PeerId != connectedPeerId) break;
                    connectedPeerId = "";
                    connectionState = currentMode == AppMode.StartConnection ? ConnectionState.Registered : ConnectionState.Idle;
                    _isSharingScreen = false;
                    _peerIsSharingScreen = false;
                    if (_webrtc != null)
                    {
                        await _webrtc.CloseAsync();
                        _webrtc = null;
                    }
                    break;

                case SignalingMessage.Error error:
                    errorMessage = error.Message;
                    break;
            }

            StateHasChanged();
        });
    }

    private async Task InitializeWebRTCAsViewer()
    {
        Logger.LogInformation("Initializing WebRTC as viewer");

        // Configure TURN server before WebRTC init
        await SetTurnConfigFromSettings();

        // Set logger to viewer mode (sends logs to host)
        await JSRuntime.InvokeVoidAsync("SteamViewerLogger.setMode", false);

        _webrtc = new WebRTCManager(JSRuntime, LoggerFactory.CreateLogger<WebRTCManager>(), _sessionId, "", SendSignalingMessage);

        // Subscribe to ICE candidates
        _webrtc.OnIceCandidate += async (candidateJson) =>
        {
            var candidate = System.Text.Json.JsonSerializer.Deserialize<IceCandidateData>(candidateJson);
            if (candidate != null)
            {
                await SignalingClient.SendIceCandidateAsync(connectedPeerId, candidate.candidate, candidate.sdpMid, (ushort?)candidate.sdpMLineIndex);
            }
        };

        // Subscribe to data channel open (for input sending)
        _webrtc.OnDataChannelOpen += async () =>
        {
            Logger.LogInformation("Data channel opened - ready for communication");
            _dataChannelReady = true;
            await InvokeAsync(StateHasChanged);
        };

        // Subscribe to data channel messages (for screen share notifications and input)
        _webrtc.OnDataChannelMessage += async (json) =>
        {
            await HandleDataChannelMessageAsync(json);
        };

        // Subscribe to renegotiation (triggered when screen capture track is added)
        _webrtc.OnRenegotiationNeeded += async (offerJson) =>
        {
            Logger.LogInformation("Renegotiation: sending new offer to {PeerId}", connectedPeerId);
            await SignalingClient.SendSdpOfferAsync(connectedPeerId, offerJson);
        };

        // Subscribe to stats relay (for cross-window overlay)
        _webrtc.OnStatsUpdated += OnWebRTCStatsUpdate;

        await _webrtc.InitializeAsync();
        _webrtcInitialized = true;
        Logger.LogInformation("WebRTC initialized as joiner, waiting for offer");

        // Process any buffered SDP offer (race condition fix)
        if (_pendingSdpOffer != null)
        {
            Logger.LogInformation("Processing buffered SDP offer from {PeerId}", _pendingSdpOffer.TargetId);
            await _webrtc.SetRemoteDescriptionAsync(_pendingSdpOffer.Sdp);
            var answer = await _webrtc.CreateAnswerAsync();
            await SignalingClient.SendSdpAnswerAsync(_pendingSdpOffer.TargetId, answer);
            Logger.LogInformation("SDP answer sent for buffered offer");
            _pendingSdpOffer = null;
        }

        // Process any buffered ICE candidates
        if (_pendingIceCandidates.Count > 0)
        {
            Logger.LogInformation("Processing {Count} buffered ICE candidates", _pendingIceCandidates.Count);
            foreach (var ice in _pendingIceCandidates)
            {
                var candidateJson = System.Text.Json.JsonSerializer.Serialize(new
                {
                    candidate = ice.Candidate,
                    sdpMid = ice.SdpMid,
                    sdpMLineIndex = ice.SdpMLineIndex
                });
                await _webrtc.AddIceCandidateAsync(candidateJson);
            }
            _pendingIceCandidates.Clear();
        }
    }

    private void HandleDisconnected(string? reason)
    {
        InvokeAsync(() =>
        {
            connectionState = ConnectionState.Disconnected;
            errorMessage = reason ?? "Disconnected from server";
            StateHasChanged();
        });
    }

    private void HandleError(Exception ex)
    {
        InvokeAsync(() =>
        {
            errorMessage = ex.Message;
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        SignalingClient.OnMessageReceived -= HandleMessage;
        SignalingClient.OnDisconnected -= HandleDisconnected;
        SignalingClient.OnError -= HandleError;
        SessionManager.VideoFrameDecoded -= OnVideoFrameDecoded;
        SessionManager.IncomingFileTransfer -= OnIncomingFileTransfer;
        SessionManager.FileTransferProgress -= OnFileTransferProgress;
        SessionManager.FileTransferCompleted -= OnFileTransferCompleted;
        SessionManager.FileTransferFailed -= OnFileTransferFailed;
        ViewerService.OnViewerClosed -= OnViewerClosed;
        ViewerService.OnStatsToggleRequested -= OnViewerStatsToggle;

        await StopFrameCaptureAsync();

        if (_webrtc != null)
        {
            await _webrtc.DisposeAsync();
            _webrtc = null;
        }

        if (_canvasInitialized)
        {
            await CanvasRenderer.DisposeAsync();
            _canvasInitialized = false;
        }

        if (_inputCaptureInitialized)
        {
            await JSRuntime.InvokeVoidAsync("SteamViewerInput.stop");
            _inputCaptureInitialized = false;
        }

        _inputDotNetRef?.Dispose();
        _loggerDotNetRef?.Dispose();
        _frameCaptureRef?.Dispose();
    }
}

