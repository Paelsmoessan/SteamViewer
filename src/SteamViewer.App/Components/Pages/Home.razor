@page "/"
@using SteamViewer.Client.Core.Capture
@using SteamViewer.Client.Core.FileTransfer
@using SteamViewer.Client.Core.Network
@using SteamViewer.Client.Core.Session
@using SteamViewer.App.Services
@using SteamViewer.App.Services.Models
@using SteamViewer.App.Components.FileTransfer
@using Blake3
@using System.Text
@using System.Text.Json
@using Microsoft.JSInterop
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.DependencyInjection
@using SteamViewer.Client.Core.Elevation
@using SteamViewer.Platform.Windows.ScreenCapture
@using SteamViewer.Common.Protocol
@implements IAsyncDisposable
@inject IServiceProvider ServiceProvider
@inject SignalingClient SignalingClient
@inject CanvasRenderingService CanvasRenderer
@inject IJSRuntime JSRuntime
@inject ILoggerFactory LoggerFactory
@inject ILogger<Home> Logger
@inject IInputInjector InputInjector
@inject IConfiguration Configuration
@inject FileLoggerService FileLogger
@inject ViewerSessionManager ViewerSessionManager
@inject ViewerTabManager TabManager

@if (connectionState == ConnectionState.Connected)
{
    @* === Connected as host - full-screen connected view === *@
    <div class="version-tag">v@(Version)</div>
    <div class="container connected-container">
        @RenderConnectedView()
    </div>
}
else if (connectionState == ConnectionState.Idle || connectionState == ConnectionState.Registering)
{
    @* === Splash screen while connecting === *@
    <div class="splash-screen">
        <img src="images/logo.png" alt="SteamViewer" class="splash-logo" />
        <p class="splash-title">SteamViewer</p>
        <p class="splash-subtitle">Secure Remote Desktop</p>
        <div class="splash-progress">
            <div class="splash-progress-bar"></div>
        </div>
        <p class="splash-status">Connecting to server...</p>
        <span class="splash-version">v@(Version)</span>
    </div>
}
else
{
    @* === Home screen - two-panel layout === *@
    <div class="home-shell">
        @* --- Top bar with logo --- *@
        <div class="top-bar">
            <div class="top-bar-brand">
                <img src="images/logo_banner.png" alt="" class="top-logo" />
            </div>
            <span class="top-version">v@(Version)</span>
        </div>

        @* --- Main content: two panels --- *@
        <div class="main-panels">
            @* --- Left panel: identity --- *@
            <div class="id-panel">
                <div class="id-field">
                    <label>Session ID</label>
                    <div class="id-value-row">
                        <span class="id-value">@clientId</span>
                        <button class="id-copy-btn" @onclick="CopySessionId" title="@(_copiedId ? "Copied!" : "Copy")">
                            <Icon Name="@(_copiedId ? AppIcon.Check : AppIcon.Copy)" Size="12" />
                        </button>
                    </div>
                </div>
                <div class="id-field">
                    <label>Password</label>
                    <div class="id-value-row">
                        <span class="id-value">@password</span>
                        <button class="id-copy-btn" @onclick="CopyPassword" title="@(_copiedPassword ? "Copied!" : "Copy")">
                            <Icon Name="@(_copiedPassword ? AppIcon.Check : AppIcon.Copy)" Size="12" />
                        </button>
                    </div>
                </div>
            </div>

            @* --- Right panel: connect --- *@
            <div class="connect-panel">
                <h3 class="connect-title">Connect To</h3>
                <div class="connect-form">
                    <div class="field">
                        <label>Partner ID</label>
                        <input type="text" @bind="targetId" placeholder="@_idPlaceholder" maxlength="@_idMaxLength" />
                    </div>
                    <div class="field">
                        <label>Password</label>
                        <input type="password" @bind="targetPassword" placeholder="Enter password" />
                    </div>
                    <button class="connect-btn" @onclick="JoinSession"
                            disabled="@(string.IsNullOrWhiteSpace(targetId) || string.IsNullOrWhiteSpace(targetPassword))">
                        Connect
                    </button>
                </div>
            </div>
        </div>

        @* --- Status bar --- *@
        <div class="status-bar">
            <div class="status-left">
                <span class="status-dot ready"></span>
                <span>Ready</span>
            </div>
            <div class="status-right">
                <a href="/collaboration" class="collab-link">
                    <Icon Name="AppIcon.Users" Size="13" />
                    Collaboration
                </a>
            </div>
        </div>

        @* --- Error banner --- *@
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-banner">@errorMessage</div>
        }
    </div>

    @* === Incoming connection modal === *@
    @if (connectionState == ConnectionState.Connecting && !string.IsNullOrEmpty(incomingPeerId))
    {
        <div class="modal-backdrop">
            <div class="modal-card">
                <h3>Incoming Connection</h3>
                <p class="modal-peer-id">@incomingPeerId</p>
                <p class="modal-subtitle">wants to connect to your desktop</p>
                <div class="modal-actions">
                    <button class="modal-btn accept" @onclick="AcceptConnection">
                        <Icon Name="AppIcon.Check" Size="16" />
                        Accept
                    </button>
                    <button class="modal-btn reject" @onclick="RejectConnection">
                        <Icon Name="AppIcon.X" Size="16" />
                        Reject
                    </button>
                </div>
            </div>
        </div>
    }
}

<FileTransferDialog
    IsVisible="@_showFileTransferDialog"
    Mode="@_fileDialogMode"
    PendingTransfer="@_pendingFileTransfer"
    Transfers="@(Enumerable.Empty<FileTransferState>())"
    OnClose="@CloseFileTransferDialog"
    OnAccept="@AcceptFileTransfer"
    OnReject="@RejectFileTransfer"
    OnCancel="@CancelFileTransfer" />


@code {
    private static readonly string Version = System.Reflection.CustomAttributeExtensions
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(Home).Assembly)?.InformationalVersion?.Split('+')[0] ?? "0.0.0";

#if DEBUG
    private bool _debugCredsSaved;
#endif

    private enum AppMode { Select, StartConnection, JoinConnection }

    private AppMode currentMode = AppMode.StartConnection;
    private ConnectionState connectionState = ConnectionState.Idle;

    // Session state
    private string clientId = "";
    private string password = "";
    private string passwordHash = "";
    private string incomingPeerId = "";
    private string connectedPeerId = "";
    private bool _isReconnect;
    private IElevationService? _preservedElevationService;
    private ReconnectCredentials.ReconnectResult? _pendingReconnect;

    // Join mode state
#if DEBUG
    private string targetId = "";
    private string targetPassword = "TESTPASS";
    private string _idPlaceholder = "Enter machine name";
    private string _idMaxLength = "50";
#else
    private string targetId = "";
    private string targetPassword = "";
    private string _idPlaceholder = "Enter 9-digit ID";
    private string _idMaxLength = "9";
#endif

    private string errorMessage = "";
    private bool _copiedId;
    private bool _copiedPassword;
    private bool _canvasInitialized;
    private bool _inputCaptureInitialized;
    private DotNetObjectReference<Home>? _inputDotNetRef;
    private DotNetObjectReference<Home>? _loggerDotNetRef;
    private bool _jsLoggerInitialized;

    // Host session (encapsulates WebRTC, input injection, screen sharing)
    private HostSession? _hostSession;

    // File transfer state
    private bool _showFileTransferDialog;
    private FileTransferDialog.DialogMode _fileDialogMode;
    private FileTransferState? _pendingFileTransfer;

    // Monitor picker state (DXGI native capture — no browser picker)
    private bool _showMonitorPicker;
    private List<MonitorInfo>? _availableMonitors;
    private uint _selectedMonitorId;

    // UI helper properties that delegate to HostSession
    private bool _isSharingScreen => _hostSession?.IsSharingScreen ?? false;
    private bool _peerIsSharingScreen => _hostSession?.IsPeerSharingScreen ?? false;
    private bool _dataChannelReady => _hostSession?.IsDataChannelReady ?? false;

    // Render the connected view (same for both Start and Join modes)
    private RenderFragment RenderConnectedView() => __builder =>
    {
        <div class="connected-view">
            <p class="status connected">Connected to peer</p>

            @* Screen sharing controls *@
            <div class="screen-share-controls">
                @if (_isSharingScreen)
                {
                    <button class="share-btn sharing" @onclick="StopSharingScreen">
                        <span class="icon"><Icon Name="AppIcon.Square" Size="20" /></span>
                        <span>Stop Sharing</span>
                    </button>
                    <p class="share-status">You are sharing your screen</p>
                }
                else if (_showMonitorPicker && _availableMonitors != null)
                {
                    @* Monitor picker — shown when 2+ monitors detected *@
                    <div class="monitor-picker">
                        <p class="picker-label">Select monitor to share:</p>
                        <div class="monitor-options">
                            @foreach (var mon in _availableMonitors)
                            {
                                <button class="monitor-option @(mon.Id == _selectedMonitorId ? "selected" : "")"
                                        @onclick="() => SelectAndShareMonitor(mon.Id)">
                                    <span class="monitor-name">@mon.Name</span>
                                    <span class="monitor-res">@(mon.Width)x@(mon.Height)</span>
                                    @if (mon.IsPrimary) { <span class="monitor-primary">Primary</span> }
                                </button>
                            }
                        </div>
                        <button class="share-btn cancel" @onclick="() => { _showMonitorPicker = false; StateHasChanged(); }">
                            <span>Cancel</span>
                        </button>
                    </div>
                }
                else
                {
                    <button class="share-btn" @onclick="StartSharingScreen" disabled="@(!_dataChannelReady)">
                        <span class="icon"><Icon Name="AppIcon.Monitor" Size="20" /></span>
                        <span>Share My Screen</span>
                    </button>
                    @if (!_dataChannelReady)
                    {
                        <p class="connecting-status">Establishing connection...</p>
                    }
                }
            </div>

            @* Debug: save reconnect credentials for boot relay testing *@
#if DEBUG
            <div class="debug-controls" style="margin-top: 8px;">
                <button class="share-btn" style="font-size: 11px; padding: 4px 8px; opacity: 0.6;"
                        @onclick="SaveDebugReconnectCreds" disabled="@(!_dataChannelReady)">
                    Save Reconnect Creds (Debug)
                </button>
                @if (_debugCredsSaved)
                {
                    <span style="color: #4caf50; font-size: 11px; margin-left: 8px;">Saved!</span>
                }
            </div>
#endif

            @* Remote screen display (when peer is sharing) *@
            @if (_peerIsSharingScreen)
            {
                <div class="remote-screen-container">
                    <div class="remote-screen-header">
                        <span class="remote-label"><Icon Name="AppIcon.Monitor" Size="16" /> Remote Screen</span>
                    </div>
                    <div class="remote-screen">
                        <canvas id="remoteCanvas" width="1" height="1"></canvas>
                    </div>
                </div>
            }
            else if (!_isSharingScreen)
            {
                <p class="waiting-status">Waiting for screen share...</p>
            }

            @* Toolbar *@
            <div class="session-toolbar">
                <button class="toolbar-btn" @onclick="ShowTransfersDialog"><Icon Name="AppIcon.FolderOpen" Size="14" /> Transfers</button>
                <button class="toolbar-btn disconnect" @onclick="Disconnect"><Icon Name="AppIcon.LogOut" Size="14" /> Disconnect</button>
            </div>
        </div>
    };

    protected override void OnInitialized()
    {
        SignalingClient.OnMessageReceived += HandleMessage;
        SignalingClient.OnDisconnected += HandleDisconnected;
        SignalingClient.OnError += HandleError;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _pendingReconnect = ReconnectCredentials.Load();
            if (_pendingReconnect != null)
            {
                // Reconnect with saved credentials (from reboot or elevation restart)
                Logger.LogInformation("Found valid reconnect data for ID: {Id}", _pendingReconnect.ClientId);
                _ = StartSessionWithRetryAsync();
            }
            else
            {
                // Auto-register on launch
                _ = StartSession();
            }
        }

        // Initialize JS logger on first render
        if (firstRender && !_jsLoggerInitialized)
        {
            try
            {
                _loggerDotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("SteamViewerLogger.initialize", _loggerDotNetRef);
                _jsLoggerInitialized = true;
                Logger.LogInformation("JS Logger initialized - log file: {Path}", FileLogger.LogFilePath);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to initialize JS logger");
            }
        }

        // Initialize canvas and input capture when peer is sharing screen
        if (_peerIsSharingScreen &&
            connectionState == ConnectionState.Connected &&
            !_canvasInitialized)
        {
            try
            {
                await CanvasRenderer.InitializeAsync("remoteCanvas");
                _canvasInitialized = true;
                Logger.LogInformation("Canvas initialized for video rendering");

                // Initialize input capture on canvas
                if (!_inputCaptureInitialized)
                {
                    _inputDotNetRef = DotNetObjectReference.Create(this);
                    var success = await JSRuntime.InvokeAsync<bool>(
                        "SteamViewerInput.initialize",
                        "remoteCanvas",
                        _inputDotNetRef,
                        new { showLockIndicator = false });
                    _inputCaptureInitialized = success;
                    if (success)
                    {
                        await JSRuntime.InvokeVoidAsync("SteamViewerInput.setActiveSession", "host");
                    }
                    Logger.LogInformation("Input capture initialized: {Success}", success);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to initialize canvas/input");
            }
        }
    }

    #region File Transfer Handlers

    private void ShowTransfersDialog()
    {
        _fileDialogMode = FileTransferDialog.DialogMode.ActiveTransfers;
        _showFileTransferDialog = true;
        StateHasChanged();
    }

    private void CloseFileTransferDialog()
    {
        _showFileTransferDialog = false;
        _pendingFileTransfer = null;
        StateHasChanged();
    }

    private async Task AcceptFileTransfer((Guid TransferId, string SavePath) args)
    {
        // TODO: Wire to _hostSession file transfer when implemented
        _showFileTransferDialog = false;
        _pendingFileTransfer = null;
        _fileDialogMode = FileTransferDialog.DialogMode.ActiveTransfers;
        _showFileTransferDialog = true;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task RejectFileTransfer(Guid transferId)
    {
        // TODO: Wire to _hostSession file transfer when implemented
        _showFileTransferDialog = false;
        _pendingFileTransfer = null;
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task CancelFileTransfer(Guid transferId)
    {
        // TODO: Wire to _hostSession file transfer when implemented
        StateHasChanged();
        await Task.CompletedTask;
    }

    #endregion

    private void SelectJoinMode()
    {
        currentMode = AppMode.JoinConnection;
        StateHasChanged();
    }

    private void GoBack()
    {
        currentMode = AppMode.StartConnection;
        errorMessage = "";
        StateHasChanged();
    }

    private async Task CopySessionId()
    {
        await CopyToClipboard(clientId);
        _copiedId = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(2000);
            await InvokeAsync(() =>
            {
                _copiedId = false;
                StateHasChanged();
            });
        });
    }

    private async Task CopyPassword()
    {
        await CopyToClipboard(password);
        _copiedPassword = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(2000);
            await InvokeAsync(() =>
            {
                _copiedPassword = false;
                StateHasChanged();
            });
        });
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to copy to clipboard");
        }
    }

    #region Screen Sharing

    private async Task StartSharingScreen()
    {
        if (_hostSession == null) return;

        // Enumerate DXGI monitors to decide: auto-start or show picker
        try
        {
            _availableMonitors = DxgiScreenCapture.EnumerateMonitors(Logger);
        }
        catch
        {
            _availableMonitors = null;
        }

        if (_availableMonitors != null && _availableMonitors.Count > 1)
        {
            // Multiple monitors — show picker (no browser picker!)
            _selectedMonitorId = _availableMonitors.FirstOrDefault(m => m.IsPrimary)?.Id
                ?? _availableMonitors[0].Id;
            _showMonitorPicker = true;
            StateHasChanged();
            return;
        }

        // Single monitor (or enumeration failed) — start directly
        var outputIndex = _availableMonitors?.FirstOrDefault()?.Id;
        var success = await _hostSession.StartScreenShareAsync(outputIndex);
        if (!success)
        {
            errorMessage = "Failed to start screen capture";
        }
        _showMonitorPicker = false;
        StateHasChanged();
    }

    private async Task SelectAndShareMonitor(uint monitorId)
    {
        if (_hostSession == null) return;

        _showMonitorPicker = false;
        StateHasChanged();

        var success = await _hostSession.StartScreenShareAsync(outputIndex: monitorId);
        if (!success)
        {
            errorMessage = "Failed to start screen capture";
        }
        StateHasChanged();
    }

    private async Task StopSharingScreen()
    {
        if (_hostSession == null) return;

        await _hostSession.StopScreenShareAsync();
        _showMonitorPicker = false;
        StateHasChanged();
    }

#if DEBUG
    private void SaveDebugReconnectCreds()
    {
        if (string.IsNullOrEmpty(clientId) || string.IsNullOrEmpty(passwordHash) || string.IsNullOrEmpty(connectedPeerId))
        {
            Logger.LogWarning("Cannot save reconnect creds: missing session data");
            return;
        }

        var serverUrl = Configuration["SignalingServer"] ?? "";
        ReconnectCredentials.Save(clientId, passwordHash, connectedPeerId, serverUrl);
        _debugCredsSaved = true;
        Logger.LogInformation("DEBUG: Saved reconnect credentials (clientId={Id}, serverUrl={Url})", clientId, serverUrl);
        StateHasChanged();
    }
#endif

    #endregion

    private async Task StartSession()
    {
        try
        {
            connectionState = ConnectionState.Registering;
            errorMessage = "";
            StateHasChanged();

            await SignalingClient.ConnectAsync();

            // Check for pre-loaded reconnect data (from reboot or elevation restart)
            if (_pendingReconnect != null)
            {
                clientId = _pendingReconnect.ClientId;
                passwordHash = _pendingReconnect.PasswordHash;
                password = "(reconnecting)"; // Plain password not available — hash is sufficient for registration
                _isReconnect = true;
                _pendingReconnect = null; // Consume — one-time use
                Logger.LogInformation("Reconnecting with saved credentials - ID: {Id}", clientId);
            }
            else
            {
#if DEBUG
                clientId = Environment.MachineName;
                password = "TESTPASS";
                Logger.LogInformation("DEBUG MODE: Using test credentials - ID: {Id}, Password: {Pass}", clientId, password);
#else
                clientId = new Random().Next(100000000, 999999999).ToString();
                password = Guid.NewGuid().ToString("N")[..8].ToUpperInvariant();
#endif
                passwordHash = Convert.ToHexString(
                    Hasher.Hash(Encoding.UTF8.GetBytes(password)).AsSpan()
                ).ToLowerInvariant();
            }

            var success = await SignalingClient.RegisterAsync(clientId, passwordHash);

            if (success)
            {
                connectionState = ConnectionState.Registered;
            }
            else
            {
                connectionState = ConnectionState.Error;
                errorMessage = "Failed to register with server";
                // Disconnect so next retry starts fresh
                try { await SignalingClient.DisconnectAsync(); } catch { }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start hosting");
            connectionState = ConnectionState.Error;
            errorMessage = ex.Message;
            try { await SignalingClient.DisconnectAsync(); } catch { }
        }

        StateHasChanged();
    }

    /// <summary>
    /// Auto-start with retries for elevation/reboot reconnect.
    /// Handles race condition where old client ID may still be registered.
    /// </summary>
    private async Task StartSessionWithRetryAsync(int maxAttempts = 4, int baseDelayMs = 2000)
    {
        for (int attempt = 1; attempt <= maxAttempts; attempt++)
        {
            Logger.LogInformation("Auto-start attempt {Attempt}/{Max}", attempt, maxAttempts);
            await StartSession();

            if (connectionState == ConnectionState.Registered)
            {
                Logger.LogInformation("Auto-start succeeded on attempt {Attempt}", attempt);
                ReconnectCredentials.Delete();
                return;
            }

            if (attempt < maxAttempts)
            {
                var delay = baseDelayMs * (int)Math.Pow(2, attempt - 1);
                Logger.LogWarning("Auto-start attempt {Attempt} failed, retrying in {Delay}ms", attempt, delay);
                errorMessage = $"Connecting... (attempt {attempt + 1})";
                connectionState = ConnectionState.Registering;
                StateHasChanged();
                await Task.Delay(delay);
            }
        }

        Logger.LogError("Auto-start failed after {Max} attempts", maxAttempts);
    }

    private async Task StopSession()
    {
        try
        {
            await SignalingClient.DisconnectAsync();
            if (_hostSession != null)
            {
                await _hostSession.DisposeAsync();
                _hostSession = null;
            }
            if (_preservedElevationService != null)
            {
                await _preservedElevationService.DisposeAsync();
                _preservedElevationService = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error during disconnect");
        }

        connectionState = ConnectionState.Idle;
        clientId = "";
        password = "";
        StateHasChanged();
    }

    private async Task JoinSession()
    {
        try
        {
            connectionState = ConnectionState.Connecting;
            errorMessage = "";
            StateHasChanged();

            // Delegate entirely to ViewerSessionManager
            var session = await ViewerSessionManager.CreateSessionAsync(
                targetId, targetPassword, JSRuntime);

            if (session != null)
            {
                TabManager.OpenViewerForSession(session.SessionId, targetId);
                Logger.LogInformation("Opened viewer for peer {PeerId} via ViewerSessionManager", targetId);
            }
            else
            {
                errorMessage = "Failed to create session";
            }

            // Return to host view - viewer window handles everything
            currentMode = AppMode.StartConnection;
            connectionState = ConnectionState.Registered;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to join session");
            connectionState = ConnectionState.Error;
            errorMessage = ex.Message;
        }
        StateHasChanged();
    }

    private async Task AcceptConnection()
    {
        try
        {
            await SignalingClient.RespondToConnectionAsync(incomingPeerId, true);
            connectedPeerId = incomingPeerId;
            connectionState = ConnectionState.Connected;

            // Reuse preserved elevation service on reconnect (helpers stay alive),
            // otherwise create fresh instance from DI
            var elevationService = _preservedElevationService;
            if (elevationService != null)
            {
                Logger.LogInformation("Reusing preserved elevation service (admin={Admin}, system={System})",
                    elevationService.IsAdminConnected, elevationService.IsSystemConnected);
                _preservedElevationService = null;
            }
            else
            {
                elevationService = ServiceProvider.GetService<IElevationService>();
            }

            // Create and initialize host session
            var monitorEnumerator = ServiceProvider.GetService<IMonitorEnumerator>();
            var screenCapture = ServiceProvider.GetService<IScreenCapture>();
#if WINDOWS
            var frameBridge = ServiceProvider.GetService<Services.NativeFrameBridge>();
#endif
            _hostSession = new HostSession(
                connectedPeerId,
                JSRuntime,
                LoggerFactory,
                InputInjector,
                Configuration,
                msg => SignalingClient.SendAsync(msg),
                signalingClient: SignalingClient,
                elevationService: elevationService,
                monitorEnumerator: monitorEnumerator,
                screenCapture: screenCapture,
#if WINDOWS
                frameBridge: frameBridge,
#endif
                hostClientId: clientId,
                hostPasswordHash: passwordHash);

            // Auto-share full screen on reconnect after reboot
            if (_isReconnect)
            {
                _hostSession.AutoShareOnReady = true;
                _isReconnect = false; // One-time
            }

            _hostSession.OnStateChanged += state => InvokeAsync(StateHasChanged);
            _hostSession.OnReady += () => InvokeAsync(StateHasChanged);
            _hostSession.OnDisconnected += reason => InvokeAsync(async () =>
            {
                Logger.LogWarning("Host session disconnected: {Reason}. Resetting to accept reconnections.", reason);

                // Detach elevation service before disposing — keeps helper processes alive
                if (_hostSession != null)
                {
                    _preservedElevationService = _hostSession.DetachElevationService();
                    if (_preservedElevationService != null)
                        Logger.LogInformation("Elevation service preserved for reconnect (admin={Admin}, system={System})",
                            _preservedElevationService.IsAdminConnected, _preservedElevationService.IsSystemConnected);

                    await _hostSession.DisposeAsync();
                    _hostSession = null;
                }

                // Reset to registered state — host is still registered on signaling server
                connectedPeerId = "";
                _canvasInitialized = false;
                _isReconnect = true; // Auto-accept viewer's reconnect
                connectionState = ConnectionState.Registered;
                StateHasChanged();
            });
            _hostSession.OnPeerSharingChanged += sharing => InvokeAsync(() =>
            {
                _canvasInitialized = false; // Reset canvas when peer sharing changes
                StateHasChanged();
            });

            await _hostSession.InitializeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to accept connection");
            errorMessage = ex.Message;
        }
        StateHasChanged();
    }

    #region JS Logger

    [JSInvokable]
    public void OnJSLog(string level, string message)
    {
        FileLogger.LogJS(level, message);
    }

    #endregion

    #region Input Event Handlers - Home viewing peer screen

    [JSInvokable]
    public async Task OnMouseMove(double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        if (_hostSession == null || !_hostSession.IsDataChannelReady) return;
        await SendInputEventAsync(new InputEvent.MouseMove(x, y, captureWidth, captureHeight));
    }

    [JSInvokable]
    public async Task OnMouseDown(string button, double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        if (_hostSession == null || !_hostSession.IsDataChannelReady) return;
        await SendInputEventAsync(new InputEvent.MouseDown(ParseMouseButton(button), x, y, captureWidth, captureHeight));
    }

    [JSInvokable]
    public async Task OnMouseUp(string button, double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        if (_hostSession == null || !_hostSession.IsDataChannelReady) return;
        await SendInputEventAsync(new InputEvent.MouseUp(ParseMouseButton(button), x, y, captureWidth, captureHeight));
    }

    private static MouseButton ParseMouseButton(string button) => button.ToLowerInvariant() switch
    {
        "left" => MouseButton.Left,
        "right" => MouseButton.Right,
        "middle" => MouseButton.Middle,
        "xbutton1" => MouseButton.XButton1,
        "xbutton2" => MouseButton.XButton2,
        _ => MouseButton.Left
    };

    [JSInvokable]
    public async Task OnMouseWheel(double deltaX, double deltaY)
    {
        if (_hostSession == null || !_hostSession.IsDataChannelReady) return;
        await SendInputEventAsync(new InputEvent.MouseWheel(deltaX, deltaY));
    }

    [JSInvokable]
    public async Task OnKeyDown(string key, JsonElement modifiers)
    {
        if (_hostSession == null || !_hostSession.IsDataChannelReady) return;
        await SendInputEventAsync(new InputEvent.KeyDown(key, ParseModifiers(modifiers)));
    }

    [JSInvokable]
    public async Task OnKeyUp(string key, JsonElement modifiers)
    {
        if (_hostSession == null || !_hostSession.IsDataChannelReady) return;
        await SendInputEventAsync(new InputEvent.KeyUp(key, ParseModifiers(modifiers)));
    }

    private KeyModifiers ParseModifiers(JsonElement modifiers)
    {
        bool ctrl = false, shift = false, alt = false, meta = false;
        if (modifiers.TryGetProperty("ctrl", out var ctrlProp)) ctrl = ctrlProp.GetBoolean();
        if (modifiers.TryGetProperty("shift", out var shiftProp)) shift = shiftProp.GetBoolean();
        if (modifiers.TryGetProperty("alt", out var altProp)) alt = altProp.GetBoolean();
        if (modifiers.TryGetProperty("meta", out var metaProp)) meta = metaProp.GetBoolean();
        return new KeyModifiers(ctrl, shift, alt, meta);
    }

    private async Task SendInputEventAsync(InputEvent inputEvent)
    {
        try
        {
            var json = JsonSerializer.Serialize(inputEvent);
            await _hostSession!.SendDataAsync(json);
        }
        catch
        {
            // Silently ignore input send failures to reduce latency
        }
    }

    #endregion

    private async Task RejectConnection()
    {
        await SignalingClient.RespondToConnectionAsync(incomingPeerId, false);
        connectionState = ConnectionState.Registered;
        incomingPeerId = "";
        StateHasChanged();
    }

    private async Task Disconnect()
    {
        if (!string.IsNullOrEmpty(connectedPeerId))
        {
            await SignalingClient.DisconnectFromPeerAsync(connectedPeerId);
        }

        if (_hostSession != null)
        {
            await _hostSession.DisposeAsync();
            _hostSession = null;
        }

        // User-initiated disconnect — fully dispose any preserved elevation
        if (_preservedElevationService != null)
        {
            await _preservedElevationService.DisposeAsync();
            _preservedElevationService = null;
        }

        connectedPeerId = "";
        _canvasInitialized = false;
        connectionState = ConnectionState.Registered;
        StateHasChanged();
    }

    private void HandleMessage(SignalingMessage message)
    {
        // Home.razor only handles HOST-side signaling.
        // Viewer-side signaling is handled by ViewerSessionManager (subscribed to same event).
        if (currentMode != AppMode.StartConnection) return;

        InvokeAsync(async () =>
        {
            switch (message)
            {
                case SignalingMessage.IncomingConnection incoming:
                    incomingPeerId = incoming.FromId;

                    // Auto-accept during reconnect (post-elevation or post-reboot)
                    if (_isReconnect)
                    {
                        Logger.LogInformation("Auto-accepting reconnect from {PeerId}", incoming.FromId);
                        await AcceptConnection();
                        break;
                    }

                    connectionState = ConnectionState.Connecting;
                    break;

                case SignalingMessage.ConnectionResponse response:
                    if (response.TargetId != incomingPeerId) break;
                    if (!response.Approved)
                    {
                        errorMessage = "Connection rejected";
                        connectionState = ConnectionState.Registered;
                    }
                    break;

                case SignalingMessage.Disconnected disconnected:
                    if (disconnected.PeerId != connectedPeerId) break;
                    if (_hostSession != null)
                    {
                        _preservedElevationService = _hostSession.DetachElevationService();
                        await _hostSession.DisposeAsync();
                        _hostSession = null;
                    }
                    connectedPeerId = "";
                    _canvasInitialized = false;
                    _isReconnect = true;
                    connectionState = ConnectionState.Registered;
                    break;

                case SignalingMessage.TransportEndpoint endpoint:
                    // Viewer's UDP candidates — forward to host session
                    if (_hostSession != null)
                    {
                        Logger.LogInformation("Routing viewer TransportEndpoint to HostSession ({CandidateCount} candidates)",
                            endpoint.Candidates.Length);
                        _ = _hostSession.HandleViewerTransportEndpointAsync(endpoint.Candidates);
                    }
                    break;

                case SignalingMessage.TransportConfirmed confirmed:
                    // Viewer confirmed UDP probe succeeded — forward to host session
                    if (_hostSession != null)
                    {
                        Logger.LogInformation("Routing TransportConfirmed to HostSession");
                        _ = _hostSession.HandleTransportConfirmedAsync();
                    }
                    break;

                case SignalingMessage.Error error:
                    errorMessage = error.Message;
                    break;
            }

            StateHasChanged();
        });
    }

    private void HandleDisconnected(string? reason)
    {
        InvokeAsync(() =>
        {
            connectionState = ConnectionState.Disconnected;
            errorMessage = reason ?? "Disconnected from server";
            StateHasChanged();
        });
    }

    private void HandleError(Exception ex)
    {
        InvokeAsync(() =>
        {
            errorMessage = ex.Message;
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        SignalingClient.OnMessageReceived -= HandleMessage;
        SignalingClient.OnDisconnected -= HandleDisconnected;
        SignalingClient.OnError -= HandleError;

        if (_hostSession != null)
        {
            await _hostSession.DisposeAsync();
            _hostSession = null;
        }

        if (_preservedElevationService != null)
        {
            await _preservedElevationService.DisposeAsync();
            _preservedElevationService = null;
        }

        // JS interop calls can throw if WebView is already torn down during app exit
        try
        {
            if (_canvasInitialized)
            {
                await CanvasRenderer.DisposeAsync();
                _canvasInitialized = false;
            }

            if (_inputCaptureInitialized)
            {
                await JSRuntime.InvokeVoidAsync("SteamViewerInput.stop");
                _inputCaptureInitialized = false;
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }

        _inputDotNetRef?.Dispose();
        _loggerDotNetRef?.Dispose();
    }
}

