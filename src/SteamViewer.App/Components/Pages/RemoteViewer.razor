@page "/viewer"
@using Microsoft.JSInterop
@using SteamViewer.App.Services
@using SteamViewer.Client.Core.Capture
@inject RemoteViewerService ViewerService
@inject CanvasRenderingService CanvasRenderer
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="viewer-container">
    <div class="viewer-toolbar">
        <div class="toolbar-menus">
            <button class="menu-btn" title="Session actions">Actions ▾</button>
            <button class="menu-btn" title="Display options">View ▾</button>
            <button class="menu-btn" title="File transfer">Files ▾</button>
        </div>
        <div class="toolbar-icons">
            <button class="icon-btn @(_inputLocked ? "locked" : "")" @onclick="ToggleInputLock" title="@(_inputLocked ? "Unlock (Esc)" : "Lock input")">
                @(_inputLocked ? "🔒" : "🔓")
            </button>
            <button class="icon-btn" title="Fullscreen">⛶</button>
            <button class="icon-btn close-btn" @onclick="CloseWindow" title="Disconnect">×</button>
        </div>
    </div>
    <div class="canvas-wrapper">
        <div class="tab-bar">
            <div class="tabs">
                <div class="tab active" title="Current session">
                    <span class="tab-icon">🖥️</span>
                    <span class="tab-title">@(ViewerService.PeerId ?? "Remote")</span>
                    <button class="tab-close" title="Close tab">×</button>
                </div>
                <div class="tab" title="Example tab (placeholder)">
                    <span class="tab-icon">🖥️</span>
                    <span class="tab-title">Server-02</span>
                    <button class="tab-close" title="Close tab">×</button>
                </div>
            </div>
            <button class="tab-add" title="New connection">+</button>
        </div>
        <div class="canvas-container" id="canvasContainer">
            <canvas id="viewerCanvas"></canvas>
        </div>
    </div>
</div>

@code {
    private DotNetObjectReference<RemoteViewer>? _dotNetRef;
    private bool _canvasInitialized;
    private bool _inputInitialized;
    private bool _inputLocked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe to JPEG frames (from main window's canvas capture)
            ViewerService.OnJpegFrame += HandleJpegFrame;

            // Initialize canvas
            await Task.Delay(100); // Wait for DOM
            try
            {
                _canvasInitialized = true;

                // Initialize input capture (without floating lock indicator - we have toolbar button)
                _dotNetRef = DotNetObjectReference.Create(this);
                _inputInitialized = await JSRuntime.InvokeAsync<bool>(
                    "SteamViewerInput.initialize",
                    "viewerCanvas",
                    _dotNetRef,
                    new { showLockIndicator = false });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to initialize viewer canvas: {ex.Message}");
            }
        }
    }

    private async Task ToggleInputLock()
    {
        _inputLocked = !_inputLocked;
        if (_inputLocked)
        {
            await JSRuntime.InvokeVoidAsync("SteamViewerInput.lock");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("SteamViewerInput.unlock");
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnInputLockChanged(bool locked)
    {
        _inputLocked = locked;
        InvokeAsync(StateHasChanged);
    }

    private async void HandleJpegFrame(JpegFrame frame)
    {
        if (_canvasInitialized)
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    await JSRuntime.InvokeVoidAsync("SteamViewerViewer.renderJpegFrame",
                        "viewerCanvas", frame.Base64Data, frame.Width, frame.Height);
                });
            }
            catch
            {
                // Ignore rendering errors during shutdown
            }
        }
    }

    private void CloseWindow()
    {
        ViewerService.CloseViewer();
    }

    #region Input Callbacks (relayed to main window)

    [JSInvokable]
    public void OnMouseMove(double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        ViewerService.SendInputEvent(new InputEventData
        {
            Type = InputEventType.MouseMove,
            X = x,
            Y = y,
            CaptureWidth = captureWidth,
            CaptureHeight = captureHeight
        });
    }

    [JSInvokable]
    public void OnMouseDown(string button, double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        ViewerService.SendInputEvent(new InputEventData
        {
            Type = InputEventType.MouseDown,
            X = x,
            Y = y,
            Button = button == "left" ? 0 : button == "right" ? 2 : 1,
            CaptureWidth = captureWidth,
            CaptureHeight = captureHeight
        });
    }

    [JSInvokable]
    public void OnMouseUp(string button, double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        ViewerService.SendInputEvent(new InputEventData
        {
            Type = InputEventType.MouseUp,
            X = x,
            Y = y,
            Button = button == "left" ? 0 : button == "right" ? 2 : 1,
            CaptureWidth = captureWidth,
            CaptureHeight = captureHeight
        });
    }

    [JSInvokable]
    public void OnMouseWheel(double deltaX, double deltaY)
    {
        ViewerService.SendInputEvent(new InputEventData
        {
            Type = InputEventType.Wheel,
            DeltaX = deltaX,
            DeltaY = deltaY
        });
    }

    [JSInvokable]
    public void OnKeyDown(string key, System.Text.Json.JsonElement modifiers)
    {
        var (ctrl, shift, alt) = ParseModifiers(modifiers);
        ViewerService.SendInputEvent(new InputEventData
        {
            Type = InputEventType.KeyDown,
            Key = key,
            Ctrl = ctrl,
            Shift = shift,
            Alt = alt
        });
    }

    [JSInvokable]
    public void OnKeyUp(string key, System.Text.Json.JsonElement modifiers)
    {
        var (ctrl, shift, alt) = ParseModifiers(modifiers);
        ViewerService.SendInputEvent(new InputEventData
        {
            Type = InputEventType.KeyUp,
            Key = key,
            Ctrl = ctrl,
            Shift = shift,
            Alt = alt
        });
    }

    private (bool ctrl, bool shift, bool alt) ParseModifiers(System.Text.Json.JsonElement modifiers)
    {
        bool ctrl = false, shift = false, alt = false;
        if (modifiers.TryGetProperty("ctrl", out var ctrlProp)) ctrl = ctrlProp.GetBoolean();
        if (modifiers.TryGetProperty("shift", out var shiftProp)) shift = shiftProp.GetBoolean();
        if (modifiers.TryGetProperty("alt", out var altProp)) alt = altProp.GetBoolean();
        return (ctrl, shift, alt);
    }

    #endregion

    public void Dispose()
    {
        ViewerService.OnJpegFrame -= HandleJpegFrame;
        _dotNetRef?.Dispose();

        // Notify service that window is closing
        ViewerService.NotifyViewerClosed();
    }
}

<style>
    .viewer-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: #11111b;
        color: #cdd6f4;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .viewer-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 28px;
        padding: 0 6px;
        background: #1e1e2e;
        border-bottom: 1px solid #313244;
        flex-shrink: 0;
    }

    .toolbar-menus {
        display: flex;
        gap: 2px;
    }

    .menu-btn {
        background: transparent;
        border: none;
        color: #a6adc8;
        padding: 4px 10px;
        font-size: 12px;
        cursor: pointer;
        border-radius: 3px;
        transition: all 0.15s;
    }

    .menu-btn:hover {
        background: #313244;
        color: #cdd6f4;
    }

    .toolbar-icons {
        display: flex;
        gap: 2px;
    }

    .icon-btn {
        width: 24px;
        height: 24px;
        background: transparent;
        border: none;
        color: #a6adc8;
        font-size: 12px;
        cursor: pointer;
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
    }

    .icon-btn:hover {
        background: #313244;
        color: #cdd6f4;
    }

    .icon-btn.locked {
        background: #a6e3a1;
        color: #1e1e2e;
    }

    .icon-btn.locked:hover {
        background: #94e2d5;
    }

    .close-btn:hover {
        background: #f38ba8;
        color: #1e1e2e;
    }

    .canvas-wrapper {
        flex: 1;
        position: relative;
        min-height: 0;
    }

    /* Floating tab bar - overlays canvas, connects to toolbar */
    .tab-bar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        display: flex;
        align-items: flex-start; /* Align to top to connect with toolbar */
        height: 36px;
        padding: 0 8px;
        background: transparent; /* Canvas shows through! */
        transition: opacity 0.2s;
    }

    /* Auto-fade: tabs faded by default, light up on tab-bar hover */
    .tab-bar {
        opacity: 0.3;
        transition: opacity 0.3s ease 0.25s; /* 0.25s delay before fading */
    }

    .tab-bar:hover {
        opacity: 1;
        transition: opacity 0.15s ease; /* Instant appear */
    }

    .tabs {
        display: flex;
        align-items: flex-start; /* Align to top */
    }

    /* Chrome-style slanted tab with frosted glass - wider at top, connects to toolbar */
    .tab {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 30px;
        padding: 0 16px 0 12px;
        background: rgba(30, 30, 46, 0.9);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        cursor: pointer;
        min-width: 120px;
        max-width: 200px;
        margin-top: -1px; /* Overlap toolbar to prevent shimmering line */
        /* Slanted trapezoid with beveled bottom corners */
        clip-path: polygon(
            0 0,                          /* top-left */
            100% 0,                       /* top-right */
            calc(100% - 4px) calc(100% - 6px),  /* right bevel start */
            calc(100% - 10px) 100%,       /* bottom-right */
            10px 100%,                    /* bottom-left */
            4px calc(100% - 6px)          /* left bevel start */
        );
        transition: all 0.15s;
    }

    .tab:hover {
        background: rgba(69, 71, 90, 0.95);
    }

    .tab.active {
        background: rgba(30, 30, 46, 0.95);
        z-index: 1;
    }

    .tab.active::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: #89b4fa;
    }

    .tab-icon {
        font-size: 12px;
        flex-shrink: 0;
    }

    .tab-title {
        font-size: 11px;
        color: #a6adc8;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
    }

    .tab.active .tab-title {
        color: #cdd6f4;
    }

    .tab-close {
        width: 16px;
        height: 16px;
        border: none;
        background: transparent;
        color: #6c7086;
        font-size: 12px;
        cursor: pointer;
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        opacity: 0;
        transition: all 0.15s;
    }

    .tab:hover .tab-close {
        opacity: 1;
    }

    .tab-close:hover {
        background: #f38ba8;
        color: #1e1e2e;
    }

    .tab-add {
        width: 28px;
        height: 28px;
        background: rgba(30, 30, 46, 0.7);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: none;
        border-radius: 0 0 6px 6px; /* Rounded at bottom only */
        color: #6c7086;
        font-size: 16px;
        margin-left: 8px;
        margin-top: 1px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
    }

    .tab-add:hover {
        background: rgba(69, 71, 90, 0.9);
        color: #cdd6f4;
    }

    /* Canvas fills entire wrapper, behind tabs */
    .canvas-container {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        align-items: stretch;
        justify-content: stretch;
        overflow: hidden;
        background: #000;
    }

    .canvas-container canvas {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
</style>
