@page "/viewer"
@using Microsoft.JSInterop
@using SteamViewer.App.Services
@using SteamViewer.App.Services.Models
@using SteamViewer.App.Components.Shared
@using SteamViewer.Common.Protocol
@inject ViewerSessionManager SessionManager
@inject ViewerTabManager TabManager
@inject CanvasRenderingService CanvasRenderer
@inject IJSRuntime JSRuntime
@inject FileLoggerService FileLogger
@implements IDisposable

<div class="viewer-container" @onclick="CloseMenus" @onclick:stopPropagation="false">
    <div class="viewer-toolbar">
        <div class="toolbar-menus">
            <div class="menu-wrapper">
                <button class="menu-btn @(_activeMenu == "actions" ? "active" : "")"
                        @onclick='() => ToggleMenu("actions")'
                        @onclick:stopPropagation="true"
                        title="Session actions">Actions ▾</button>
                @if (_activeMenu == "actions")
                {
                    <div class="menu-dropdown" @onclick:stopPropagation="true">
                        <div class="menu-section">
                            <span class="menu-section-title">Special Keys</span>
                            <button class="menu-item" @onclick="SendCtrlShiftEsc" title="Open Task Manager">
                                <span class="menu-icon">📋</span>
                                <span>Task Manager</span>
                                <span class="menu-shortcut">Ctrl+Shift+Esc</span>
                            </button>
                            <button class="menu-item" @onclick="SendWinD" title="Show Desktop">
                                <span class="menu-icon">🖥️</span>
                                <span>Show Desktop</span>
                                <span class="menu-shortcut">Win+D</span>
                            </button>
                            <button class="menu-item" @onclick="SendWinL" title="Lock Screen">
                                <span class="menu-icon">🔒</span>
                                <span>Lock Screen</span>
                                <span class="menu-shortcut">Win+L</span>
                            </button>
                            <button class="menu-item" @onclick="SendAltTab" title="Switch Windows">
                                <span class="menu-icon">🔄</span>
                                <span>Switch Windows</span>
                                <span class="menu-shortcut">Alt+Tab</span>
                            </button>
                            <button class="menu-item" @onclick="SendAltF4" title="Close Active Window">
                                <span class="menu-icon">❌</span>
                                <span>Close Window</span>
                                <span class="menu-shortcut">Alt+F4</span>
                            </button>
                        </div>
                        <div class="menu-divider"></div>
                        <div class="menu-section">
                            <span class="menu-section-title">System</span>
                            <button class="menu-item @(_hostElevated != true ? "disabled" : "")"
                                    @onclick="SendCtrlAltDel"
                                    title="@(_hostElevated != true ? "Host needs admin privileges" : "Send Ctrl+Alt+Del to host")">
                                <span class="menu-icon">🛡️</span>
                                <span>Ctrl+Alt+Del</span>
                                @if (_hostElevated == true)
                                {
                                    <span class="menu-shortcut">Ctrl+Alt+End</span>
                                }
                                else
                                {
                                    <span class="menu-note">Needs admin</span>
                                }
                            </button>
                            <button class="menu-item" @onclick="SendRebootHost" title="Reboot the remote host">
                                <span class="menu-icon">🔄</span>
                                <span>Reboot Host</span>
                            </button>
                            @if (_hostElevated == false)
                            {
                                <button class="menu-item" @onclick="RequestElevation" title="Enable admin features on host (UAC prompt will appear on host)">
                                    <span class="menu-icon">⬆️</span>
                                    <span>Enable Admin</span>
                                </button>
                            }
                            @* SYSTEM helper auto-launches with Admin — no separate button needed *@
                        </div>
                        <div class="menu-divider"></div>
                        <div class="menu-section">
                            <span class="menu-section-title">Clipboard</span>
                            <button class="menu-item" @onclick="SendClipboardToHost" title="Send your clipboard text to the remote machine">
                                <span class="menu-icon">📋</span>
                                <span>Paste to Remote</span>
                            </button>
                            <button class="menu-item" @onclick="GetClipboardFromHost" title="Copy the remote machine's clipboard text">
                                <span class="menu-icon">📥</span>
                                <span>Copy from Remote</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
            <div class="menu-wrapper">
                <button class="menu-btn @(_activeMenu == "view" ? "active" : "")"
                        @onclick='() => ToggleMenu("view")'
                        @onclick:stopPropagation="true"
                        title="Display options">View ▾</button>
                @if (_activeMenu == "view")
                {
                    <div class="menu-dropdown" @onclick:stopPropagation="true">
                        <button class="menu-item" @onclick="ToggleFullscreen">
                            <span class="menu-icon">⛶</span>
                            <span>Fullscreen</span>
                            <span class="menu-shortcut">F11</span>
                        </button>
                    </div>
                }
            </div>
            <div class="menu-wrapper">
                <button class="menu-btn @(_activeMenu == "files" ? "active" : "")"
                        @onclick='() => ToggleMenu("files")'
                        @onclick:stopPropagation="true"
                        title="File transfer">Files ▾</button>
                @if (_activeMenu == "files")
                {
                    <div class="menu-dropdown" @onclick:stopPropagation="true">
                        <button class="menu-item disabled">
                            <span class="menu-icon">📤</span>
                            <span>Send File...</span>
                        </button>
                        <button class="menu-item disabled">
                            <span class="menu-icon">📥</span>
                            <span>Receive File...</span>
                        </button>
                    </div>
                }
            </div>
        </div>
        <div class="toolbar-icons">
            <button class="icon-btn @(_inputLocked ? "locked" : "")" @onclick="ToggleInputLock" title="@(_inputLocked ? "Unlock input" : "Lock input")">
                @(_inputLocked ? "🔒" : "🔓")
            </button>
            <button class="icon-btn @(_statsVisible ? "active-toggle" : "")" @onclick="ToggleStatsOverlay" title="Toggle stats overlay">📊</button>
            <button class="icon-btn" @onclick="ToggleFullscreen" title="Fullscreen (F11)">⛶</button>
            <button class="icon-btn close-btn" @onclick="CloseWindow" title="Close window">×</button>
        </div>
    </div>
    <div class="canvas-wrapper">
        <div class="tab-bar" data-window-id="@_windowId">
            <div class="tabs">
                @foreach (var tab in _tabs)
                {
                    <div class="tab @(tab.IsActive ? "active" : "") @(tab.IsConnected ? "" : "disconnected")"
                         title="@tab.Title"
                         @onclick="() => SwitchTab(tab.SessionId)"
                         @onclick:stopPropagation="true"
                         data-session-id="@tab.SessionId">
                        <span class="tab-icon">@GetTabIcon(tab)</span>
                        <span class="tab-title">@tab.Title</span>
                        <button class="tab-close"
                                title="Close tab"
                                @onclick="() => CloseTab(tab.SessionId)"
                                @onclick:stopPropagation="true">×</button>
                    </div>
                }
            </div>
            <button class="tab-add" title="New connection" @onclick="OpenConnectionDialog">+</button>
        </div>
        <div class="canvas-container" id="canvasContainer">
            <canvas id="viewerCanvas" class="@(_secureDesktopActive ? "canvas-dimmed" : "")"></canvas>
            <canvas id="secureDesktopOverlay" class="secure-desktop-overlay" style="display: @(_secureDesktopActive ? "block" : "none")"></canvas>
            @if (_secureDesktopActive)
            {
                <div class="secure-desktop-banner">@(_secureDesktopFrameReceived ? "Secure Desktop (UAC)" : "Secure Desktop — Waiting...")</div>
            }
            @if (_tabs.Count == 0)
            {
                <div class="no-tabs-message">
                    <p>No active sessions</p>
                    <button class="add-connection-btn" @onclick="OpenConnectionDialog">+ Add Connection</button>
                </div>
            }
            @if (_activeSessionId != null && !_hasReceivedFrame && !_showReconnectOverlay)
            {
                <div class="connecting-overlay">
                    <div class="connecting-spinner"></div>
                    <p class="connecting-text">Waiting for host screen...</p>
                    <p class="connecting-subtext">Establishing connection to @(_activeSession?.PeerId ?? "peer")</p>
                </div>
            }
            @if (_statsVisible && _statsText != null)
            {
                <div class="stats-overlay">
                    <pre>@_statsText</pre>
                </div>
            }
            @if (_toastMessage != null)
            {
                <div class="toast-notification">@_toastMessage</div>
            }
            @if (_showReconnectOverlay)
            {
                <div class="reconnect-overlay">
                    <div class="reconnect-dialog">
                        <h3>Host Disconnected</h3>
                        @if (_reconnectCountdown > 0)
                        {
                            <p>Reconnecting in @_reconnectCountdown seconds...</p>
                        }
                        else
                        {
                            <p>Attempting to reconnect...</p>
                        }
                        <div class="reconnect-buttons">
                            <button class="btn-primary" @onclick="ReconnectNow">Reconnect Now</button>
                            <button class="btn-secondary" @onclick="CancelReconnect">Cancel</button>
                            <button class="btn-danger" @onclick="CloseDisconnectedTab">Close Tab</button>
                        </div>
                        <p class="reconnect-attempts">Attempt @(_reconnectAttempts + 1)</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<ConnectionDialog
    IsVisible="@_showConnectionDialog"
    WindowId="@_windowId"
    OnClose="CloseConnectionDialog"
    OnConnected="HandleConnected" />

@code {
    private DotNetObjectReference<RemoteViewer>? _dotNetRef;
    private DotNetObjectReference<RemoteViewer>? _tabDragRef;
    private DotNetObjectReference<RemoteViewer>? _loggerDotNetRef;
    private bool _canvasInitialized;
    private bool _inputInitialized;
    private bool _tabDragInitialized;
    private bool _inputLocked;
    private string? _windowId;
    private List<TabState> _tabs = new();
    private bool _showConnectionDialog;
    private string? _activeMenu;
    private string? _activeSessionId;
    private ViewerSession? _activeSession;
    private bool _showReconnectOverlay;
    private int _reconnectCountdown;
    private System.Threading.Timer? _reconnectTimer;
    private int _reconnectAttempts;
    private bool _statsVisible;
    private string? _statsText;
    private string? _toastMessage;
    private bool? _hostElevated;
    private bool? _hostSystemLevel;
    private bool _hasReceivedFrame;
    private bool _secureDesktopActive;
    private bool _secureDesktopFrameReceived;

    protected override void OnInitialized()
    {
        // Claim a pre-created window (from OpenViewerForSession/DetachTab) or create a new one
        _windowId = TabManager.ClaimOrCreateWindow();

        // Subscribe to tab manager events
        TabManager.OnTabsChanged += HandleTabsChanged;
        TabManager.OnActiveTabChanged += HandleActiveTabChanged;

        RefreshTabs();

        // If the window already has an active tab (OpenViewerForSession added it before we subscribed),
        // manually activate it now since we missed the OnActiveTabChanged event.
        var activeTab = TabManager.GetActiveTab(_windowId);
        if (activeTab != null && _activeSessionId == null)
        {
            HandleActiveTabChanged(_windowId, activeTab.SessionId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize canvas
            await Task.Delay(100); // Wait for DOM
            try
            {
                _canvasInitialized = true;

                // Initialize input capture (without floating lock indicator - we have toolbar button)
                _dotNetRef = DotNetObjectReference.Create(this);
                _inputInitialized = await JSRuntime.InvokeAsync<bool>(
                    "SteamViewerInput.initialize",
                    "viewerCanvas",
                    _dotNetRef,
                    new { showLockIndicator = false });

                // Initialize tab drag functionality
                _tabDragRef = DotNetObjectReference.Create(this);
                _tabDragInitialized = await JSRuntime.InvokeAsync<bool>(
                    "SteamViewerTabDrag.initialize",
                    _tabDragRef);

                // Set window ID on tab bar for cross-window drops
                if (_windowId != null)
                {
                    await JSRuntime.InvokeVoidAsync("SteamViewerTabDrag.setTabBarWindowId", _windowId);
                }

                // Initialize JS logger bridge so console output reaches the log file
                _loggerDotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("SteamViewerLogger.initialize", _loggerDotNetRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to initialize viewer canvas: {ex.Message}");
            }
        }
    }

    #region Tab Drag Callbacks

    [JSInvokable]
    public void OnTabDragStart(string sessionId)
    {
        // Tab drag started - could update UI state if needed
        Console.WriteLine($"Tab drag started: {sessionId}");
    }

    [JSInvokable]
    public async Task OnTabDetached(string sessionId, int screenX, int screenY)
    {
        // Tab dragged outside window - create new window
        if (_windowId == null) return;

        Console.WriteLine($"Tab detached: {sessionId} at ({screenX}, {screenY})");
        TabManager.DetachTab(_windowId, sessionId, screenX, screenY);
        await Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnTabDroppedOnWindow(string sessionId, string targetWindowId)
    {
        // Tab dropped on another window's tab bar
        if (_windowId == null) return;

        Console.WriteLine($"Tab dropped: {sessionId} from {_windowId} to {targetWindowId}");
        TabManager.MoveTab(_windowId, targetWindowId, sessionId);
        await Task.CompletedTask;
    }

    #endregion

    private void RefreshTabs()
    {
        if (_windowId == null) return;
        _tabs = TabManager.GetTabs(_windowId).ToList();
    }

    private void HandleTabsChanged(string windowId)
    {
        if (windowId != _windowId) return;
        InvokeAsync(() =>
        {
            RefreshTabs();
            StateHasChanged();
        });
    }

    private TabState? ActiveTab => _tabs.FirstOrDefault(t => t.SessionId == _activeSessionId);

    private void HandleActiveTabChanged(string windowId, string? sessionId)
    {
        if (windowId != _windowId) return;

        // Save current tab's per-tab state before switching
        var oldTab = _tabs.FirstOrDefault(t => t.SessionId == _activeSessionId);
        if (oldTab != null)
        {
            oldTab.StatsVisible = _statsVisible;
            oldTab.InputLocked = _inputLocked;
        }

        // Pause frame capture and unsubscribe from previous session
        if (_activeSession != null)
        {
            var oldSessionId = _activeSession.SessionId;
            _activeSession.OnFrame -= HandleSessionFrame;
            _activeSession.OnDisconnected -= HandleSessionDisconnected;
            _activeSession.OnStatsUpdated -= HandleStatsUpdate;
            _activeSession.OnControlMessage -= HandleControlMessage;
            _activeSession.OnClipboardReceived -= HandleClipboardReceived;
            _activeSession.OnSecureDesktopStateChanged -= HandleSecureDesktopStateChanged;
            _activeSession.OnSecureDesktopFrame -= HandleSecureDesktopFrame;
            if (_statsVisible) _ = _activeSession.DisableStatsRelayAsync();
            _ = JSRuntime.InvokeVoidAsync("SteamViewerWebRTC.pauseFrameCapture", oldSessionId);
        }

        _activeSessionId = sessionId;
        _hasReceivedFrame = false;
        _showReconnectOverlay = false;
        _secureDesktopActive = false;
        _secureDesktopFrameReceived = false;
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;

        // Update input's active session for stats tracking
        if (!string.IsNullOrEmpty(sessionId))
        {
            _ = JSRuntime.InvokeVoidAsync("SteamViewerInput.setActiveSession", sessionId);
        }

        // Subscribe to new active session's frames and resume capture
        if (sessionId != null)
        {
            _activeSession = SessionManager.GetSession(sessionId);
            if (_activeSession != null)
            {
                _activeSession.OnFrame += HandleSessionFrame;
                _activeSession.OnDisconnected += HandleSessionDisconnected;
                _activeSession.OnStatsUpdated += HandleStatsUpdate;
                _activeSession.OnControlMessage += HandleControlMessage;
                _activeSession.OnClipboardReceived += HandleClipboardReceived;
                _activeSession.OnSecureDesktopStateChanged += HandleSecureDesktopStateChanged;
                _activeSession.OnSecureDesktopFrame += HandleSecureDesktopFrame;

                _ = JSRuntime.InvokeVoidAsync("SteamViewerWebRTC.resumeFrameCapture", sessionId);

                // Show reconnect overlay if session is already disconnected
                if (_activeSession.State == ViewerSessionState.Disconnected)
                {
                    ShowReconnectOverlay("Session disconnected");
                }
            }
        }
        else
        {
            _activeSession = null;
        }

        // Restore new tab's per-tab state
        var newTab = _tabs.FirstOrDefault(t => t.SessionId == sessionId);
        _statsVisible = newTab?.StatsVisible ?? false;
        _inputLocked = newTab?.InputLocked ?? false;
        _hostElevated = _activeSession?.IsHostElevated;
        if (!_statsVisible) _statsText = null;

        // Enable stats relay on new tab if it had stats on
        if (_statsVisible && _activeSession != null)
        {
            _ = _activeSession.EnableStatsRelayAsync();
        }

        // Apply restored input lock state to JS
        if (_inputLocked)
            _ = JSRuntime.InvokeVoidAsync("SteamViewerInput.lock");
        else
            _ = JSRuntime.InvokeVoidAsync("SteamViewerInput.unlock");

        InvokeAsync(StateHasChanged);
    }

    private void HandleSessionDisconnected(string? reason)
    {
        Console.WriteLine($"Session disconnected: {reason}");
        ShowReconnectOverlay(reason);
    }

    private void HandleControlMessage(string type, string? message)
    {
        InvokeAsync(() =>
        {
            switch (type)
            {
                case "hostStatus":
                    var wasElevated = _hostElevated;
                    var wasSystemLevel = _hostSystemLevel;
                    _hostElevated = _activeSession?.IsHostElevated;
                    _hostSystemLevel = _activeSession?.IsHostSystemLevel;
                    if (_hostElevated == true && wasElevated != true)
                        ShowToast("Admin features enabled");
                    // SYSTEM auto-launches with Admin — no toast (avoids focus race)
                    StateHasChanged();
                    break;
                case "ctrlAltDelFailed":
                    ShowToast(message ?? "Ctrl+Alt+Del failed");
                    break;
                case "rebootFailed":
                    ShowToast(message ?? "Reboot failed");
                    break;
                case "elevationDenied":
                    ShowToast(message ?? "Elevation denied on host");
                    break;
                case "elevationAlready":
                    _hostElevated = true;
                    ShowToast("Admin features already enabled");
                    StateHasChanged();
                    break;
                case "systemElevationAlready":
                    _hostSystemLevel = true;
                    ShowToast("SYSTEM features already enabled");
                    StateHasChanged();
                    break;
                case "systemElevationDenied":
                    ShowToast(message ?? "SYSTEM elevation denied");
                    break;
                case "systemElevationFailed":
                    ShowToast(message ?? "SYSTEM elevation failed");
                    break;
                case "runAsSystemSuccess":
                    ShowToast("Launched as SYSTEM");
                    break;
                case "runAsSystemFailed":
                    ShowToast(message ?? "Run as SYSTEM failed");
                    break;
            }
        });
    }

    private void HandleSessionFrame(JpegFrame frame)
    {
        if (!_hasReceivedFrame)
        {
            _hasReceivedFrame = true;
            _ = InvokeAsync(StateHasChanged);
        }

        // Frames from multi-session manager
        if (_canvasInitialized)
        {
            _ = InvokeAsync(async () =>
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("SteamViewerViewer.renderJpegFrame",
                        "viewerCanvas", frame.Base64Data, frame.Width, frame.Height);
                }
                catch
                {
                    // Ignore rendering errors during shutdown
                }
            });
        }
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        StateHasChanged();
        // Refocus canvas after re-render to preserve keyboard capture
        _ = RefocusCanvasAsync();
        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            await InvokeAsync(() =>
            {
                _toastMessage = null;
                StateHasChanged();
            });
        });
    }

    private async Task RefocusCanvasAsync()
    {
        try
        {
            // Multiple refocus attempts with increasing delays to combat Blazor re-render stealing focus.
            // StateHasChanged() triggers an async re-render that can complete at varying times.
            await Task.Delay(200);
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('viewerCanvas')?.focus()");
            await Task.Delay(300);
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('viewerCanvas')?.focus()");
        }
        catch { }
    }

    private void SwitchTab(string sessionId)
    {
        if (_windowId == null) return;

        TabManager.SetActiveTab(_windowId, sessionId);
    }

    private async Task CloseTab(string sessionId)
    {
        if (_windowId == null) return;

        await TabManager.RemoveTabAsync(_windowId, sessionId);

        // If no tabs left, close window
        if (_tabs.Count == 0)
        {
            CloseWindow();
        }
    }

    private string GetTabIcon(TabState tab)
    {
        if (!tab.IsConnected) return "⚠️";
        if (tab.IsPeerSharing) return "🖥️";
        return "🔗";
    }

    private void OpenConnectionDialog()
    {
        _showConnectionDialog = true;
        StateHasChanged();
    }

    private void CloseConnectionDialog()
    {
        _showConnectionDialog = false;
        StateHasChanged();
    }

    private void HandleConnected(string sessionId)
    {
        _showConnectionDialog = false;
        RefreshTabs();
        StateHasChanged();
    }

    private async Task ToggleStatsOverlay()
    {
        _statsVisible = !_statsVisible;

        if (_activeSession != null)
        {
            if (_statsVisible)
                await _activeSession.EnableStatsRelayAsync();
            else
                await _activeSession.DisableStatsRelayAsync();
        }

        if (!_statsVisible) _statsText = null;
        if (ActiveTab != null) ActiveTab.StatsVisible = _statsVisible;
        StateHasChanged();
    }

    private async Task ToggleInputLock()
    {
        _inputLocked = !_inputLocked;
        if (_inputLocked)
        {
            await JSRuntime.InvokeVoidAsync("SteamViewerInput.lock");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("SteamViewerInput.unlock");
        }
        if (ActiveTab != null) ActiveTab.InputLocked = _inputLocked;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnInputLockChanged(bool locked)
    {
        _inputLocked = locked;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnJSLog(string level, string message)
    {
        FileLogger.LogJS(level, message);
    }

    #region Menu Handling

    private void ToggleMenu(string menuName)
    {
        _activeMenu = _activeMenu == menuName ? null : menuName;
        StateHasChanged();
    }

    private void CloseMenus()
    {
        if (_activeMenu != null)
        {
            _activeMenu = null;
            StateHasChanged();
        }
    }

    #endregion

    #region Hard Key Actions

    private void SendCtrlShiftEsc()
    {
        // Send Ctrl+Shift+Esc to open Task Manager
        SendKeyCombo("Escape", ctrl: true, shift: true);
        CloseMenus();
    }

    private void SendWinD()
    {
        // Send Win+D to show desktop
        SendKeyCombo("d", meta: true);
        CloseMenus();
    }

    private void SendWinL()
    {
        // Send Win+L to lock screen
        SendKeyCombo("l", meta: true);
        CloseMenus();
    }

    private void SendAltTab()
    {
        // Send Alt+Tab to switch windows
        SendKeyCombo("Tab", alt: true);
        CloseMenus();
    }

    private void SendAltF4()
    {
        // Send Alt+F4 to close active window
        SendKeyCombo("F4", alt: true);
        CloseMenus();
    }

    private void SendKeyCombo(string key, bool ctrl = false, bool shift = false, bool alt = false, bool meta = false)
    {
        var modifiers = new KeyModifiers(ctrl, shift, alt, meta);

        // Send key down
        SendInputToActiveSession(new InputEvent.KeyDown(key, modifiers));

        // Small delay then key up (handled asynchronously)
        _ = Task.Run(async () =>
        {
            await Task.Delay(50);
            await InvokeAsync(() => SendInputToActiveSession(new InputEvent.KeyUp(key, modifiers)));
        });
    }

    #endregion

    #region System Actions

    private async Task SendCtrlAltDel()
    {
        CloseMenus();
        if (_activeSession == null || _hostElevated != true) return;

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new { type = "ctrlAltDel" });
            await _activeSession.SendDataAsync(json);
        }
        catch (Exception ex)
        {
            ShowToast("Failed to send Ctrl+Alt+Del");
            Console.WriteLine($"SendCtrlAltDel error: {ex.Message}");
        }
    }

    private async Task SendRebootHost()
    {
        CloseMenus();
        if (_activeSession == null) return;

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new { type = "rebootHost" });
            await _activeSession.SendDataAsync(json);
        }
        catch (Exception ex)
        {
            ShowToast("Failed to send reboot request");
            Console.WriteLine($"SendRebootHost error: {ex.Message}");
        }
    }

    private async Task RequestElevation()
    {
        CloseMenus();
        if (_activeSession == null) return;

        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new { type = "requestElevation" });
            await _activeSession.SendDataAsync(json);
            ShowToast("Requesting admin features — UAC prompt on host...");
        }
        catch (Exception ex)
        {
            ShowToast("Failed to request elevation");
            Console.WriteLine($"RequestElevation error: {ex.Message}");
        }
    }

    // SYSTEM helper auto-launches with Admin in WindowsElevationService — no separate request needed

    #endregion

    #region Clipboard

    private async Task SendClipboardToHost()
    {
        CloseMenus();
        if (_activeSession == null) return;
        try
        {
            var text = await JSRuntime.InvokeAsync<string>("navigator.clipboard.readText");
            if (string.IsNullOrEmpty(text))
            {
                ShowToast("Clipboard is empty");
                return;
            }
            await _activeSession.SendClipboardAsync("text", text);
            ShowToast($"Sent {text.Length} chars to remote");
        }
        catch
        {
            ShowToast("Failed to read clipboard");
        }
    }

    private async Task GetClipboardFromHost()
    {
        CloseMenus();
        if (_activeSession == null) return;
        await _activeSession.RequestClipboardAsync();
        ShowToast("Requesting remote clipboard...");
    }

    private void HandleClipboardReceived(string format, string data)
    {
        InvokeAsync(async () =>
        {
            if (format == "text")
            {
                await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", data);
                ShowToast($"Remote clipboard copied ({data.Length} chars)");
            }
        });
    }

    #endregion

    #region Secure Desktop

    private int _sdRazorFrameCount;

    private void HandleSecureDesktopStateChanged(bool active)
    {
        FileLogger.Log("INFO", "RemoteViewer", $"HandleSecureDesktopStateChanged: active={active}");
        InvokeAsync(async () =>
        {
            _secureDesktopActive = active;
            FileLogger.Log("INFO", "RemoteViewer", $"Calling JS SteamViewerSecureDesktop.{(active ? "show" : "hide")}");
            if (active)
            {
                _secureDesktopFrameReceived = false;
                await JSRuntime.InvokeVoidAsync("SteamViewerSecureDesktop.show", "secureDesktopOverlay");
            }
            else
            {
                _secureDesktopFrameReceived = false;
                await JSRuntime.InvokeVoidAsync("SteamViewerSecureDesktop.hide", "secureDesktopOverlay");
            }
            StateHasChanged();
        });
    }

    private void HandleSecureDesktopFrame(string base64Jpeg, int width, int height)
    {
        _sdRazorFrameCount++;
        if (_sdRazorFrameCount <= 3 || _sdRazorFrameCount % 100 == 0)
            FileLogger.Log("INFO", "RemoteViewer", $"SD frame #{_sdRazorFrameCount}: {base64Jpeg.Length} chars, {width}x{height}, active={_secureDesktopActive}");

        if (!_secureDesktopActive)
        {
            FileLogger.Log("WARN", "RemoteViewer", "SD frame received but _secureDesktopActive=false — dropping");
            return;
        }

        if (!_secureDesktopFrameReceived)
        {
            _secureDesktopFrameReceived = true;
            InvokeAsync(StateHasChanged); // Update banner text from "Waiting..." to "Secure Desktop (UAC)"
        }

        _ = JSRuntime.InvokeVoidAsync("SteamViewerSecureDesktop.renderFrame", "secureDesktopOverlay", base64Jpeg, width, height);
    }

    #endregion

    private async Task ToggleFullscreen()
    {
        // Check if currently in fullscreen and toggle
        await JSRuntime.InvokeVoidAsync("eval", @"
            if (document.fullscreenElement) {
                document.exitFullscreen();
            } else {
                document.documentElement.requestFullscreen();
            }
        ");
        CloseMenus();
    }

    private void HandleStatsUpdate(string json)
    {
        InvokeAsync(() =>
        {
            _statsText = FormatStats(json);
            StateHasChanged();
        });
    }

    private static string FormatStats(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var r = doc.RootElement;

            var fps = r.GetProperty("videoFps").GetDouble();
            var mbps = r.GetProperty("bitrateMbps").GetDouble();
            var res = r.GetProperty("resolution").GetString() ?? "?";
            var rtt = r.GetProperty("rttMs").GetDouble();
            var loss = r.GetProperty("lossPercent").GetDouble();
            var input = r.GetProperty("inputPerSec").GetInt32();
            var throttled = r.GetProperty("throttledPerSec").GetInt32();
            var bufKB = r.GetProperty("bufferKB").GetDouble();
            var videoBytes = r.GetProperty("currentBytes").GetInt64();
            var ctrlBytes = r.GetProperty("dataChannelBytes").GetInt64();
            var mode = r.GetProperty("qualityMode").GetString() ?? "HQ";

            var throttledStr = throttled > 0 ? $" ({throttled} throttled)" : "";
            return $"Video: {fps:F0} FPS | {mbps:F1} Mbps | {res}\n"
                 + $"Net:   RTT {rtt:F0}ms | Loss {loss:F1}%\n"
                 + $"Input: {input} evt/s{throttledStr} | Buf: {bufKB:F0} KB\n"
                 + $"Data:  {FmtBytes(videoBytes)} video | {FmtBytes(ctrlBytes)} ctrl\n"
                 + $"Mode:  [{mode}]";
        }
        catch
        {
            return json; // Fallback: show raw JSON
        }
    }

    private static string FmtBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1048576) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1073741824) return $"{bytes / 1048576.0:F1} MB";
        return $"{bytes / 1073741824.0:F2} GB";
    }

    private void CloseWindow()
    {
        if (_windowId != null)
        {
            // Remove all tabs (disconnects sessions) then triggers window close
            _ = TabManager.RemoveWindowAsync(_windowId);
        }
    }

    #region Input Callbacks (relayed to main window or active session)

    private void SendInputToActiveSession(InputEvent inputEvent)
    {
        if (_activeSession != null)
        {
            _ = _activeSession.SendInputAsync(inputEvent);
        }
    }

    [JSInvokable]
    public void OnMouseMove(double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        SendInputToActiveSession(new InputEvent.MouseMove(x, y, captureWidth, captureHeight));
    }

    [JSInvokable]
    public void OnMouseDown(string button, double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        var mouseButton = button.ToLowerInvariant() switch
        {
            "left" => MouseButton.Left,
            "right" => MouseButton.Right,
            "middle" => MouseButton.Middle,
            _ => MouseButton.Left
        };
        SendInputToActiveSession(new InputEvent.MouseDown(mouseButton, x, y, captureWidth, captureHeight));
    }

    [JSInvokable]
    public void OnMouseUp(string button, double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        var mouseButton = button.ToLowerInvariant() switch
        {
            "left" => MouseButton.Left,
            "right" => MouseButton.Right,
            "middle" => MouseButton.Middle,
            _ => MouseButton.Left
        };
        SendInputToActiveSession(new InputEvent.MouseUp(mouseButton, x, y, captureWidth, captureHeight));
    }

    [JSInvokable]
    public void OnMouseWheel(double deltaX, double deltaY)
    {
        SendInputToActiveSession(new InputEvent.MouseWheel(deltaX, deltaY));
    }

    [JSInvokable]
    public void OnKeyDown(string key, System.Text.Json.JsonElement modifiers)
    {
        var (ctrl, shift, alt) = ParseModifiers(modifiers);

        // Ctrl+Alt+End → Ctrl+Alt+Del (standard RDP convention)
        if (key == "End" && ctrl && alt)
        {
            _ = SendCtrlAltDel();
            return;
        }

        SendInputToActiveSession(new InputEvent.KeyDown(key, new KeyModifiers(ctrl, shift, alt, false)));
    }

    [JSInvokable]
    public void OnKeyUp(string key, System.Text.Json.JsonElement modifiers)
    {
        var (ctrl, shift, alt) = ParseModifiers(modifiers);
        if (key == "End" && ctrl && alt) return;

        SendInputToActiveSession(new InputEvent.KeyUp(key, new KeyModifiers(ctrl, shift, alt, false)));
    }

    private (bool ctrl, bool shift, bool alt) ParseModifiers(System.Text.Json.JsonElement modifiers)
    {
        bool ctrl = false, shift = false, alt = false;
        if (modifiers.TryGetProperty("ctrl", out var ctrlProp)) ctrl = ctrlProp.GetBoolean();
        if (modifiers.TryGetProperty("shift", out var shiftProp)) shift = shiftProp.GetBoolean();
        if (modifiers.TryGetProperty("alt", out var altProp)) alt = altProp.GetBoolean();
        return (ctrl, shift, alt);
    }

    #endregion

    #region Reconnect Logic

    private void ShowReconnectOverlay(string? reason)
    {
        _showReconnectOverlay = true;
        _reconnectAttempts = 0;
        StartReconnectCountdown();
        InvokeAsync(StateHasChanged);
    }

    private void StartReconnectCountdown()
    {
        // Exponential backoff: 10s, 20s, 40s, ... max 300s (5 min)
        var baseDelay = 10;
        var maxDelay = 300;
        var delay = Math.Min(baseDelay * (int)Math.Pow(2, _reconnectAttempts), maxDelay);
        _reconnectCountdown = delay;

        _reconnectTimer?.Dispose();
        _reconnectTimer = new System.Threading.Timer(
            async _ => await OnReconnectTimerTick(),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));
    }

    private async Task OnReconnectTimerTick()
    {
        _reconnectCountdown--;

        if (_reconnectCountdown <= 0)
        {
            _reconnectTimer?.Dispose();
            _reconnectTimer = null;
            await TryReconnect();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task TryReconnect()
    {
        if (_activeSession == null || _activeSessionId == null) return;

        _reconnectAttempts++;
        Console.WriteLine($"Reconnect attempt {_reconnectAttempts} for session {_activeSessionId}");

        try
        {
            var newSession = await SessionManager.ReconnectSessionAsync(_activeSessionId, JSRuntime);
            if (newSession != null)
            {
                // Unsubscribe from old session events
                _activeSession.OnFrame -= HandleSessionFrame;
                _activeSession.OnDisconnected -= HandleSessionDisconnected;
                _activeSession.OnStatsUpdated -= HandleStatsUpdate;
                _activeSession.OnControlMessage -= HandleControlMessage;
                _activeSession.OnClipboardReceived -= HandleClipboardReceived;
                _activeSession.OnSecureDesktopStateChanged -= HandleSecureDesktopStateChanged;
                _activeSession.OnSecureDesktopFrame -= HandleSecureDesktopFrame;

                // Update references (session ID stays the same for tab tracking)
                _activeSessionId = newSession.SessionId;
                _activeSession = newSession;

                // Subscribe to new session events
                _activeSession.OnFrame += HandleSessionFrame;
                _activeSession.OnDisconnected += HandleSessionDisconnected;
                _activeSession.OnStatsUpdated += HandleStatsUpdate;
                _activeSession.OnControlMessage += HandleControlMessage;
                _activeSession.OnClipboardReceived += HandleClipboardReceived;
                _activeSession.OnSecureDesktopStateChanged += HandleSecureDesktopStateChanged;
                _activeSession.OnSecureDesktopFrame += HandleSecureDesktopFrame;

                // Update JS input routing
                await JSRuntime.InvokeVoidAsync("SteamViewerInput.setActiveSession", newSession.SessionId);

                // Hide reconnect overlay, show "waiting for host screen"
                _showReconnectOverlay = false;
                _hasReceivedFrame = false;
                _reconnectAttempts = 0;
                StateHasChanged();
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Reconnect attempt {_reconnectAttempts} failed: {ex.Message}");
        }

        // Reconnect failed, try again with backoff
        StartReconnectCountdown();
    }

    private async Task ReconnectNow()
    {
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;
        _reconnectCountdown = 0;
        await TryReconnect();
    }

    private void CancelReconnect()
    {
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;
        _showReconnectOverlay = false;
        StateHasChanged();
    }

    private async Task CloseDisconnectedTab()
    {
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;
        _showReconnectOverlay = false;

        if (_activeSessionId != null)
        {
            await CloseTab(_activeSessionId);
        }
    }

    #endregion

    public void Dispose()
    {
        // Clean up reconnect timer
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;

        TabManager.OnTabsChanged -= HandleTabsChanged;
        TabManager.OnActiveTabChanged -= HandleActiveTabChanged;

        // Unsubscribe from active session
        if (_activeSession != null)
        {
            _activeSession.OnFrame -= HandleSessionFrame;
            _activeSession.OnDisconnected -= HandleSessionDisconnected;
            _activeSession.OnStatsUpdated -= HandleStatsUpdate;
            _activeSession.OnControlMessage -= HandleControlMessage;
            _activeSession.OnClipboardReceived -= HandleClipboardReceived;
            _activeSession.OnSecureDesktopStateChanged -= HandleSecureDesktopStateChanged;
            _activeSession.OnSecureDesktopFrame -= HandleSecureDesktopFrame;
        }

        _dotNetRef?.Dispose();
        _tabDragRef?.Dispose();
        _loggerDotNetRef?.Dispose();

        // Dispose tab drag JS
        if (_tabDragInitialized)
        {
            try
            {
                _ = JSRuntime.InvokeVoidAsync("SteamViewerTabDrag.dispose");
            }
            catch { }
        }

        // Remove window from tab manager
        if (_windowId != null)
        {
            _ = TabManager.RemoveWindowAsync(_windowId);
        }
    }
}

