@page "/viewer"
@using Microsoft.JSInterop
@using SteamViewer.App.Services
@using SteamViewer.App.Services.Models
@using SteamViewer.App.Components.Shared
@using SteamViewer.Client.Core.Capture
@using SteamViewer.Common.Protocol
@inject RemoteViewerService ViewerService
@inject ViewerSessionManager SessionManager
@inject ViewerTabManager TabManager
@inject CanvasRenderingService CanvasRenderer
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="viewer-container">
    <div class="viewer-toolbar">
        <div class="toolbar-menus">
            <button class="menu-btn" title="Session actions">Actions ▾</button>
            <button class="menu-btn" title="Display options">View ▾</button>
            <button class="menu-btn" title="File transfer">Files ▾</button>
        </div>
        <div class="toolbar-icons">
            <button class="icon-btn @(_inputLocked ? "locked" : "")" @onclick="ToggleInputLock" title="@(_inputLocked ? "Unlock (Esc)" : "Lock input")">
                @(_inputLocked ? "🔒" : "🔓")
            </button>
            <button class="icon-btn @(_statsVisible ? "active-toggle" : "")" @onclick="ToggleStatsOverlay" title="Toggle stats overlay">📊</button>
            <button class="icon-btn" title="Fullscreen">⛶</button>
            <button class="icon-btn close-btn" @onclick="CloseWindow" title="Close window">×</button>
        </div>
    </div>
    <div class="canvas-wrapper">
        <div class="tab-bar" data-window-id="@_windowId">
            <div class="tabs">
                @foreach (var tab in _tabs)
                {
                    <div class="tab @(tab.IsActive ? "active" : "") @(tab.IsConnected ? "" : "disconnected")"
                         title="@tab.Title"
                         @onclick="() => SwitchTab(tab.SessionId)"
                         @onclick:stopPropagation="true"
                         data-session-id="@tab.SessionId">
                        <span class="tab-icon">@GetTabIcon(tab)</span>
                        <span class="tab-title">@tab.Title</span>
                        <button class="tab-close"
                                title="Close tab"
                                @onclick="() => CloseTab(tab.SessionId)"
                                @onclick:stopPropagation="true">×</button>
                    </div>
                }
            </div>
            <button class="tab-add" title="New connection" @onclick="OpenConnectionDialog">+</button>
        </div>
        <div class="canvas-container" id="canvasContainer">
            <canvas id="viewerCanvas"></canvas>
            @if (_tabs.Count == 0)
            {
                <div class="no-tabs-message">
                    <p>No active sessions</p>
                    <button class="add-connection-btn" @onclick="OpenConnectionDialog">+ Add Connection</button>
                </div>
            }
            @if (_showReconnectOverlay)
            {
                <div class="reconnect-overlay">
                    <div class="reconnect-dialog">
                        <h3>Host Disconnected</h3>
                        @if (_reconnectCountdown > 0)
                        {
                            <p>Reconnecting in @_reconnectCountdown seconds...</p>
                        }
                        else
                        {
                            <p>Attempting to reconnect...</p>
                        }
                        <div class="reconnect-buttons">
                            <button class="btn-primary" @onclick="ReconnectNow">Reconnect Now</button>
                            <button class="btn-secondary" @onclick="CancelReconnect">Cancel</button>
                            <button class="btn-danger" @onclick="CloseDisconnectedTab">Close Tab</button>
                        </div>
                        <p class="reconnect-attempts">Attempt @(_reconnectAttempts + 1)</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<ConnectionDialog
    IsVisible="@_showConnectionDialog"
    WindowId="@_windowId"
    OnClose="CloseConnectionDialog"
    OnConnected="HandleConnected" />

@code {
    private DotNetObjectReference<RemoteViewer>? _dotNetRef;
    private DotNetObjectReference<RemoteViewer>? _tabDragRef;
    private bool _canvasInitialized;
    private bool _inputInitialized;
    private bool _tabDragInitialized;
    private bool _inputLocked;
    private string? _windowId;
    private List<TabState> _tabs = new();
    private bool _showConnectionDialog;
    private string? _activeSessionId;
    private ViewerSession? _activeSession;
    private bool _showReconnectOverlay;
    private int _reconnectCountdown;
    private System.Threading.Timer? _reconnectTimer;
    private int _reconnectAttempts;
    private bool _statsVisible;

    protected override void OnInitialized()
    {
        // Get or create window ID for this viewer
        _windowId = TabManager.CreateWindow();

        // Subscribe to tab manager events
        TabManager.OnTabsChanged += HandleTabsChanged;
        TabManager.OnActiveTabChanged += HandleActiveTabChanged;

        // Subscribe to legacy single-session service for backward compatibility
        ViewerService.OnJpegFrame += HandleJpegFrame;

        // If legacy service has a peer, register the tab with TabManager
        if (!string.IsNullOrEmpty(ViewerService.PeerId))
        {
            TabManager.AddTab(_windowId, "legacy", ViewerService.PeerId);
            _activeSessionId = "legacy";
        }

        RefreshTabs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize canvas
            await Task.Delay(100); // Wait for DOM
            try
            {
                _canvasInitialized = true;

                // Initialize input capture (without floating lock indicator - we have toolbar button)
                _dotNetRef = DotNetObjectReference.Create(this);
                _inputInitialized = await JSRuntime.InvokeAsync<bool>(
                    "SteamViewerInput.initialize",
                    "viewerCanvas",
                    _dotNetRef,
                    new { showLockIndicator = false });

                // Initialize tab drag functionality
                _tabDragRef = DotNetObjectReference.Create(this);
                _tabDragInitialized = await JSRuntime.InvokeAsync<bool>(
                    "SteamViewerTabDrag.initialize",
                    _tabDragRef);

                // Set window ID on tab bar for cross-window drops
                if (_windowId != null)
                {
                    await JSRuntime.InvokeVoidAsync("SteamViewerTabDrag.setTabBarWindowId", _windowId);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to initialize viewer canvas: {ex.Message}");
            }
        }
    }

    #region Tab Drag Callbacks

    [JSInvokable]
    public void OnTabDragStart(string sessionId)
    {
        // Tab drag started - could update UI state if needed
        Console.WriteLine($"Tab drag started: {sessionId}");
    }

    [JSInvokable]
    public async Task OnTabDetached(string sessionId, int screenX, int screenY)
    {
        // Tab dragged outside window - create new window
        if (_windowId == null) return;

        Console.WriteLine($"Tab detached: {sessionId} at ({screenX}, {screenY})");
        TabManager.DetachTab(_windowId, sessionId, screenX, screenY);
        await Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnTabDroppedOnWindow(string sessionId, string targetWindowId)
    {
        // Tab dropped on another window's tab bar
        if (_windowId == null) return;

        Console.WriteLine($"Tab dropped: {sessionId} from {_windowId} to {targetWindowId}");
        TabManager.MoveTab(_windowId, targetWindowId, sessionId);
        await Task.CompletedTask;
    }

    #endregion

    private void RefreshTabs()
    {
        if (_windowId == null) return;
        _tabs = TabManager.GetTabs(_windowId).ToList();
    }

    private void HandleTabsChanged(string windowId)
    {
        if (windowId != _windowId) return;
        InvokeAsync(() =>
        {
            RefreshTabs();
            StateHasChanged();
        });
    }

    private void HandleActiveTabChanged(string windowId, string? sessionId)
    {
        if (windowId != _windowId) return;

        // Unsubscribe from previous session
        if (_activeSession != null)
        {
            _activeSession.OnFrame -= HandleSessionFrame;
            _activeSession.OnDisconnected -= HandleSessionDisconnected;
        }

        _activeSessionId = sessionId;
        _showReconnectOverlay = false;
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;

        // Update input's active session for stats tracking
        var inputSessionId = sessionId == "legacy" ? "host" : sessionId;
        if (!string.IsNullOrEmpty(inputSessionId))
        {
            _ = JSRuntime.InvokeVoidAsync("SteamViewerInput.setActiveSession", inputSessionId);
        }

        // Subscribe to new active session's frames
        if (sessionId != null && sessionId != "legacy")
        {
            _activeSession = SessionManager.GetSession(sessionId);
            if (_activeSession != null)
            {
                _activeSession.OnFrame += HandleSessionFrame;
                _activeSession.OnDisconnected += HandleSessionDisconnected;

                // Show reconnect overlay if session is already disconnected
                if (_activeSession.State == ViewerSessionState.Disconnected)
                {
                    ShowReconnectOverlay("Session disconnected");
                }
            }
        }
        else
        {
            _activeSession = null;
        }

        InvokeAsync(StateHasChanged);
    }

    private void HandleSessionDisconnected(string? reason)
    {
        Console.WriteLine($"Session disconnected: {reason}");
        ShowReconnectOverlay(reason);
    }

    private void HandleSessionFrame(JpegFrame frame)
    {
        // Frames from multi-session manager
        if (_canvasInitialized)
        {
            _ = InvokeAsync(async () =>
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("SteamViewerViewer.renderJpegFrame",
                        "viewerCanvas", frame.Base64Data, frame.Width, frame.Height);
                }
                catch
                {
                    // Ignore rendering errors during shutdown
                }
            });
        }
    }

    private void SwitchTab(string sessionId)
    {
        if (_windowId == null) return;

        if (sessionId == "legacy")
        {
            // Legacy mode - already showing the only session
            return;
        }

        TabManager.SetActiveTab(_windowId, sessionId);
    }

    private async Task CloseTab(string sessionId)
    {
        if (_windowId == null) return;

        if (sessionId == "legacy")
        {
            // Legacy mode - close the window
            CloseWindow();
            return;
        }

        await TabManager.RemoveTabAsync(_windowId, sessionId);

        // If no tabs left, close window
        if (_tabs.Count == 0)
        {
            CloseWindow();
        }
    }

    private string GetTabIcon(TabState tab)
    {
        if (!tab.IsConnected) return "⚠️";
        if (tab.IsPeerSharing) return "🖥️";
        return "🔗";
    }

    private void OpenConnectionDialog()
    {
        _showConnectionDialog = true;
        StateHasChanged();
    }

    private void CloseConnectionDialog()
    {
        _showConnectionDialog = false;
        StateHasChanged();
    }

    private void HandleConnected(string sessionId)
    {
        _showConnectionDialog = false;
        RefreshTabs();
        StateHasChanged();
    }

    private async Task ToggleStatsOverlay()
    {
        // Use active session ID for stats, or "host" for legacy single-session mode
        var statsSessionId = _activeSessionId == "legacy" ? "host" : _activeSessionId;
        if (string.IsNullOrEmpty(statsSessionId)) return;

        _statsVisible = !_statsVisible;
        await JSRuntime.InvokeVoidAsync("SteamViewerWebRTC.toggleStatsOverlay", statsSessionId);
        StateHasChanged();
    }

    private async Task ToggleInputLock()
    {
        _inputLocked = !_inputLocked;
        if (_inputLocked)
        {
            await JSRuntime.InvokeVoidAsync("SteamViewerInput.lock");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("SteamViewerInput.unlock");
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnInputLockChanged(bool locked)
    {
        _inputLocked = locked;
        InvokeAsync(StateHasChanged);
    }

    private async void HandleJpegFrame(JpegFrame frame)
    {
        if (_canvasInitialized)
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    await JSRuntime.InvokeVoidAsync("SteamViewerViewer.renderJpegFrame",
                        "viewerCanvas", frame.Base64Data, frame.Width, frame.Height);
                });
            }
            catch
            {
                // Ignore rendering errors during shutdown
            }
        }
    }

    private void CloseWindow()
    {
        ViewerService.CloseViewer();
    }

    #region Input Callbacks (relayed to main window or active session)

    private void SendInputToActiveSession(InputEvent inputEvent)
    {
        // Route input to active session (multi-tab) or legacy service
        if (_activeSession != null && _activeSessionId != "legacy")
        {
            _ = _activeSession.SendInputAsync(inputEvent);
        }
        else if (_activeSessionId == "legacy")
        {
            // Legacy mode - relay through ViewerService
            var data = inputEvent switch
            {
                InputEvent.MouseMove m => new InputEventData
                {
                    Type = InputEventType.MouseMove,
                    X = m.X,
                    Y = m.Y,
                    CaptureWidth = m.CaptureWidth,
                    CaptureHeight = m.CaptureHeight
                },
                InputEvent.MouseDown m => new InputEventData
                {
                    Type = InputEventType.MouseDown,
                    X = m.X,
                    Y = m.Y,
                    Button = (int)m.Button,
                    CaptureWidth = m.CaptureWidth,
                    CaptureHeight = m.CaptureHeight
                },
                InputEvent.MouseUp m => new InputEventData
                {
                    Type = InputEventType.MouseUp,
                    X = m.X,
                    Y = m.Y,
                    Button = (int)m.Button,
                    CaptureWidth = m.CaptureWidth,
                    CaptureHeight = m.CaptureHeight
                },
                InputEvent.MouseWheel m => new InputEventData
                {
                    Type = InputEventType.Wheel,
                    DeltaX = m.DeltaX,
                    DeltaY = m.DeltaY
                },
                InputEvent.KeyDown k => new InputEventData
                {
                    Type = InputEventType.KeyDown,
                    Key = k.Key,
                    Ctrl = k.Modifiers.Ctrl,
                    Shift = k.Modifiers.Shift,
                    Alt = k.Modifiers.Alt
                },
                InputEvent.KeyUp k => new InputEventData
                {
                    Type = InputEventType.KeyUp,
                    Key = k.Key,
                    Ctrl = k.Modifiers.Ctrl,
                    Shift = k.Modifiers.Shift,
                    Alt = k.Modifiers.Alt
                },
                _ => null
            };
            if (data != null) ViewerService.SendInputEvent(data);
        }
    }

    [JSInvokable]
    public void OnMouseMove(double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        SendInputToActiveSession(new InputEvent.MouseMove(x, y, captureWidth, captureHeight));
    }

    [JSInvokable]
    public void OnMouseDown(string button, double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        var mouseButton = button.ToLowerInvariant() switch
        {
            "left" => MouseButton.Left,
            "right" => MouseButton.Right,
            "middle" => MouseButton.Middle,
            _ => MouseButton.Left
        };
        SendInputToActiveSession(new InputEvent.MouseDown(mouseButton, x, y, captureWidth, captureHeight));
    }

    [JSInvokable]
    public void OnMouseUp(string button, double x, double y, int captureWidth = 0, int captureHeight = 0)
    {
        var mouseButton = button.ToLowerInvariant() switch
        {
            "left" => MouseButton.Left,
            "right" => MouseButton.Right,
            "middle" => MouseButton.Middle,
            _ => MouseButton.Left
        };
        SendInputToActiveSession(new InputEvent.MouseUp(mouseButton, x, y, captureWidth, captureHeight));
    }

    [JSInvokable]
    public void OnMouseWheel(double deltaX, double deltaY)
    {
        SendInputToActiveSession(new InputEvent.MouseWheel(deltaX, deltaY));
    }

    [JSInvokable]
    public void OnKeyDown(string key, System.Text.Json.JsonElement modifiers)
    {
        var (ctrl, shift, alt) = ParseModifiers(modifiers);
        SendInputToActiveSession(new InputEvent.KeyDown(key, new KeyModifiers(ctrl, shift, alt, false)));
    }

    [JSInvokable]
    public void OnKeyUp(string key, System.Text.Json.JsonElement modifiers)
    {
        var (ctrl, shift, alt) = ParseModifiers(modifiers);
        SendInputToActiveSession(new InputEvent.KeyUp(key, new KeyModifiers(ctrl, shift, alt, false)));
    }

    private (bool ctrl, bool shift, bool alt) ParseModifiers(System.Text.Json.JsonElement modifiers)
    {
        bool ctrl = false, shift = false, alt = false;
        if (modifiers.TryGetProperty("ctrl", out var ctrlProp)) ctrl = ctrlProp.GetBoolean();
        if (modifiers.TryGetProperty("shift", out var shiftProp)) shift = shiftProp.GetBoolean();
        if (modifiers.TryGetProperty("alt", out var altProp)) alt = altProp.GetBoolean();
        return (ctrl, shift, alt);
    }

    #endregion

    #region Reconnect Logic

    private void ShowReconnectOverlay(string? reason)
    {
        _showReconnectOverlay = true;
        _reconnectAttempts = 0;
        StartReconnectCountdown();
        InvokeAsync(StateHasChanged);
    }

    private void StartReconnectCountdown()
    {
        // Exponential backoff: 10s, 20s, 40s, ... max 300s (5 min)
        var baseDelay = 10;
        var delay = Math.Min(baseDelay * (int)Math.Pow(2, _reconnectAttempts), 300);
        _reconnectCountdown = delay;

        _reconnectTimer?.Dispose();
        _reconnectTimer = new System.Threading.Timer(
            async _ => await OnReconnectTimerTick(),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));
    }

    private async Task OnReconnectTimerTick()
    {
        _reconnectCountdown--;

        if (_reconnectCountdown <= 0)
        {
            _reconnectTimer?.Dispose();
            _reconnectTimer = null;
            await TryReconnect();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task TryReconnect()
    {
        if (_activeSession == null || _activeSessionId == null) return;

        _reconnectAttempts++;
        Console.WriteLine($"Reconnect attempt {_reconnectAttempts} for session {_activeSessionId}");

        // TODO: Implement actual reconnection via SessionManager
        // For now, just restart the countdown
        // await SessionManager.ReconnectSessionAsync(_activeSessionId);

        // If reconnect fails, start countdown again
        StartReconnectCountdown();
    }

    private async Task ReconnectNow()
    {
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;
        _reconnectCountdown = 0;
        await TryReconnect();
    }

    private void CancelReconnect()
    {
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;
        _showReconnectOverlay = false;
        StateHasChanged();
    }

    private async Task CloseDisconnectedTab()
    {
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;
        _showReconnectOverlay = false;

        if (_activeSessionId != null)
        {
            await CloseTab(_activeSessionId);
        }
    }

    #endregion

    public void Dispose()
    {
        // Clean up reconnect timer
        _reconnectTimer?.Dispose();
        _reconnectTimer = null;

        TabManager.OnTabsChanged -= HandleTabsChanged;
        TabManager.OnActiveTabChanged -= HandleActiveTabChanged;
        ViewerService.OnJpegFrame -= HandleJpegFrame;

        // Unsubscribe from active session
        if (_activeSession != null)
        {
            _activeSession.OnFrame -= HandleSessionFrame;
            _activeSession.OnDisconnected -= HandleSessionDisconnected;
        }

        _dotNetRef?.Dispose();
        _tabDragRef?.Dispose();

        // Dispose tab drag JS
        if (_tabDragInitialized)
        {
            try
            {
                _ = JSRuntime.InvokeVoidAsync("SteamViewerTabDrag.dispose");
            }
            catch { }
        }

        // Remove window from tab manager
        if (_windowId != null)
        {
            _ = TabManager.RemoveWindowAsync(_windowId);
        }

        // Notify service that window is closing
        ViewerService.NotifyViewerClosed();
    }
}

<style>
    .viewer-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: #11111b;
        color: #cdd6f4;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .viewer-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 28px;
        padding: 0 6px;
        background: #1e1e2e;
        border-bottom: 1px solid #313244;
        flex-shrink: 0;
    }

    .toolbar-menus {
        display: flex;
        gap: 2px;
    }

    .menu-btn {
        background: transparent;
        border: none;
        color: #a6adc8;
        padding: 4px 10px;
        font-size: 12px;
        cursor: pointer;
        border-radius: 3px;
        transition: all 0.15s;
    }

    .menu-btn:hover {
        background: #313244;
        color: #cdd6f4;
    }

    .toolbar-icons {
        display: flex;
        gap: 2px;
    }

    .icon-btn {
        width: 24px;
        height: 24px;
        background: transparent;
        border: none;
        color: #a6adc8;
        font-size: 12px;
        cursor: pointer;
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
    }

    .icon-btn:hover {
        background: #313244;
        color: #cdd6f4;
    }

    .icon-btn.locked {
        background: #a6e3a1;
        color: #1e1e2e;
    }

    .icon-btn.locked:hover {
        background: #94e2d5;
    }

    .icon-btn.active-toggle {
        background: #89b4fa;
        color: #1e1e2e;
    }

    .icon-btn.active-toggle:hover {
        background: #b4befe;
    }

    .close-btn:hover {
        background: #f38ba8;
        color: #1e1e2e;
    }

    .canvas-wrapper {
        flex: 1;
        position: relative;
        min-height: 0;
    }

    /* Floating tab bar - overlays canvas, connects to toolbar */
    .tab-bar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        display: flex;
        align-items: flex-start;
        height: 36px;
        padding: 0 8px;
        background: transparent;
        transition: opacity 0.2s;
    }

    /* Auto-fade: tabs faded by default, light up on tab-bar hover */
    .tab-bar {
        opacity: 0.3;
        transition: opacity 0.3s ease 0.25s;
    }

    .tab-bar:hover {
        opacity: 1;
        transition: opacity 0.15s ease;
    }

    .tabs {
        display: flex;
        align-items: flex-start;
    }

    /* Chrome-style slanted tab with frosted glass */
    .tab {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 30px;
        padding: 0 16px 0 12px;
        background: rgba(30, 30, 46, 0.9);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        cursor: pointer;
        min-width: 120px;
        max-width: 200px;
        margin-top: -1px;
        clip-path: polygon(
            0 0,
            100% 0,
            calc(100% - 4px) calc(100% - 6px),
            calc(100% - 10px) 100%,
            10px 100%,
            4px calc(100% - 6px)
        );
        transition: all 0.15s;
        position: relative;
    }

    .tab:hover {
        background: rgba(69, 71, 90, 0.95);
    }

    .tab.active {
        background: rgba(30, 30, 46, 0.95);
        z-index: 1;
    }

    .tab.active::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: #89b4fa;
    }

    .tab.disconnected {
        opacity: 0.6;
    }

    .tab.disconnected .tab-title {
        color: #f38ba8;
    }

    .tab-icon {
        font-size: 12px;
        flex-shrink: 0;
    }

    .tab-title {
        font-size: 11px;
        color: #a6adc8;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
    }

    .tab.active .tab-title {
        color: #cdd6f4;
    }

    .tab-close {
        width: 16px;
        height: 16px;
        border: none;
        background: transparent;
        color: #6c7086;
        font-size: 12px;
        cursor: pointer;
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        opacity: 0;
        transition: all 0.15s;
    }

    .tab:hover .tab-close {
        opacity: 1;
    }

    .tab-close:hover {
        background: #f38ba8;
        color: #1e1e2e;
    }

    .tab-add {
        width: 28px;
        height: 28px;
        background: rgba(30, 30, 46, 0.7);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: none;
        border-radius: 0 0 6px 6px;
        color: #6c7086;
        font-size: 16px;
        margin-left: 8px;
        margin-top: 1px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
    }

    .tab-add:hover {
        background: rgba(69, 71, 90, 0.9);
        color: #cdd6f4;
    }

    /* Canvas fills entire wrapper, behind tabs */
    .canvas-container {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
