@using SteamViewer.Common.Protocol
@inject IJSRuntime JS

<div class="screen-grid @GetGridClass()">
    @foreach (var participant in SharingParticipants)
    {
        <div class="screen-tile @(SelectedPeerId == participant.Id ? "selected" : "")"
             @onclick="() => OnTileClick(participant.Id)"
             @ondblclick="() => OnTileDoubleClick(participant.Id)">
            <div class="screen-header">
                <span class="participant-name">@participant.DisplayName</span>
                @if (participant.Id == MyId)
                {
                    <span class="you-badge">(You)</span>
                }
            </div>
            <canvas id="grid-canvas-@participant.Id" class="screen-canvas"></canvas>
            <div class="screen-overlay">
                <span class="hint">Double-click to expand</span>
            </div>
        </div>
    }
</div>

@if (!SharingParticipants.Any())
{
    <div class="no-shares">
        <p>No one is sharing their screen yet.</p>
        <p>Click "Share My Screen" to start.</p>
    </div>
}

<style>
    .screen-grid {
        display: grid;
        gap: 16px;
        padding: 16px;
        height: 100%;
    }

    .grid-1 { grid-template-columns: 1fr; }
    .grid-2 { grid-template-columns: repeat(2, 1fr); }
    .grid-4 { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); }
    .grid-6 { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 1fr); }

    .screen-tile {
        position: relative;
        background: #1e1e2e;
        border: 2px solid #313244;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        transition: border-color 0.2s, transform 0.2s;
    }

    .screen-tile:hover {
        border-color: #89b4fa;
        transform: scale(1.02);
    }

    .screen-tile.selected {
        border-color: #a6e3a1;
    }

    .screen-header {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        padding: 8px 12px;
        background: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent);
        color: #cdd6f4;
        font-size: 14px;
        z-index: 1;
    }

    .you-badge {
        color: #a6e3a1;
        font-size: 12px;
        margin-left: 8px;
    }

    .screen-canvas {
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: #11111b;
    }

    .screen-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 8px;
        background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
        opacity: 0;
        transition: opacity 0.2s;
    }

    .screen-tile:hover .screen-overlay {
        opacity: 1;
    }

    .hint {
        color: #9399b2;
        font-size: 12px;
    }

    .no-shares {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #6c7086;
        text-align: center;
    }
</style>

@code {
    [Parameter] public IEnumerable<ParticipantInfo> SharingParticipants { get; set; } = Enumerable.Empty<ParticipantInfo>();
    [Parameter] public string? MyId { get; set; }
    [Parameter] public string? SelectedPeerId { get; set; }
    [Parameter] public EventCallback<string> OnScreenSelected { get; set; }
    [Parameter] public EventCallback<string> OnScreenFullscreen { get; set; }

    // Render function - call this from parent to render peers to canvases
    // Throttled to 1 frame per 15 seconds for thumbnails
    [Parameter] public Func<string, string, Task<bool>>? RenderPeerToCanvas { get; set; }

    private System.Timers.Timer? _renderTimer;
    private readonly object _renderLock = new();
    private bool _isRendering;

    protected override void OnInitialized()
    {
        // Render thumbnails every 15 seconds
        _renderTimer = new System.Timers.Timer(15000);
        _renderTimer.Elapsed += async (_, _) => await RenderAllThumbnailsAsync();
        _renderTimer.Start();

        // Also render immediately on first load
        _ = RenderAllThumbnailsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Render when participants change
        await RenderAllThumbnailsAsync();
    }

    private async Task RenderAllThumbnailsAsync()
    {
        if (RenderPeerToCanvas == null) return;

        lock (_renderLock)
        {
            if (_isRendering) return;
            _isRendering = true;
        }

        try
        {
            foreach (var participant in SharingParticipants)
            {
                if (participant.Id == MyId) continue; // Don't render our own stream to thumbnail

                var canvasId = $"grid-canvas-{participant.Id}";
                await RenderPeerToCanvas(participant.Id, canvasId);
            }
        }
        finally
        {
            lock (_renderLock)
            {
                _isRendering = false;
            }
        }
    }

    private string GetGridClass()
    {
        var count = SharingParticipants.Count();
        return count switch
        {
            1 => "grid-1",
            2 => "grid-2",
            <= 4 => "grid-4",
            _ => "grid-6"
        };
    }

    private async Task OnTileClick(string peerId)
    {
        await OnScreenSelected.InvokeAsync(peerId);
    }

    private async Task OnTileDoubleClick(string peerId)
    {
        await OnScreenFullscreen.InvokeAsync(peerId);
    }

    public void Dispose()
    {
        _renderTimer?.Stop();
        _renderTimer?.Dispose();
    }
}
