<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:SteamViewer.App.Components.Collaboration"
             x:Class="SteamViewer.App.CollaborationViewerPage"
             Title="Collaboration Viewer">
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type pages:FullscreenViewer}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
</ContentPage>
