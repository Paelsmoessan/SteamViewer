<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SteamViewer.Server</RootNamespace>

    <!-- Single-file release build -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- Self-contained: no .NET runtime required on target machine -->
    <!-- Set via command line: -p:SelfContained=true for distribution builds -->
    <SelfContained>false</SelfContained>

    <!-- Trimming for smaller self-contained builds -->
    <!-- Set via command line: -p:PublishTrimmed=true for distribution builds -->
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>

    <!-- Exclude debug symbols from publish -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <!-- No admin required (uses port 8080, not privileged) - Windows only -->
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <!-- Exclude config files from Release publish (configured in code) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <GenerateStaticWebAssetsManifest>false</GenerateStaticWebAssetsManifest>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Clean up extra files after publish -->
  <Target Name="CleanPublishOutput" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <FilesToDelete Include="$(PublishDir)**\*.pdb" />
      <FilesToDelete Include="$(PublishDir)**\*.json" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\SteamViewer.Common\SteamViewer.Common.csproj" />
  </ItemGroup>

</Project>
